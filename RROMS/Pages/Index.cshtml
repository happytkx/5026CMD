@page
@* Public landing page: introduces the dining spaces and links to the Sprint 2 booking flow. *@
@model RROMS.Pages.IndexModel
@{
    ViewData["Title"] = "Fine dining and reservations";
}
<section class="home-hero">
    <div class="hero-copy">
        <p class="eyebrow">WELCOME TO CÉLESTE</p>
        <h1>
            Exceptional dining.
            <br/>
            <em>
                Memorable moments.
            </em>
        </h1>
        <p>
            A thoughtfully reserved table. A beautifully shared evening.
            <br/>
            Make time for something special.
        </p>
        <a class="button" asp-page="/Reservations/Create">
            Book a table
            <span aria-hidden="true">→</span>
        </a>
        <a class="text-link" href="#dining-spaces">
            Discover our spaces
        </a>
        @if (Model.Announcements.Count > 0)
        {
            <a class="text-link" href="#announcements">Latest announcements</a>
        }
    </div>
    <figure>
        <img src="~/images/celeste-indoor.png" alt="An intimate dining room with warm architectural lighting and elegantly set tables" fetchpriority="high" />
    </figure>
</section>
@if (Model.Featured is { } feature)
{
    <section class="homepage-featured" aria-label="Featured Céleste news">
        <div class="homepage-featured-content">
            <p class="eyebrow">@(feature.IsPromotional ? "A CÉLESTE OFFER" : "FEATURED FROM CÉLESTE")</p>
            <h2>@feature.Title</h2>
            <p>@feature.Message</p>
            <a class="text-link" href="@(feature.IsPromotional ? "/Menu" : "#announcements")">
                @(feature.IsPromotional ? "Explore the menu" : "Read our news") →
            </a>
        </div>
        @if (feature.ExpiresAt.HasValue)
        {
            var remaining = Math.Max(1, (feature.ExpiresAt.Value.Date - Model.Today).Days);
            <span class="expiry-badge feature-expiry">@(remaining == 1 ? "1 day left" : $"{remaining} days left")</span>
        }
    </section>
}
<section id="dining-spaces" class="dining-spaces">
    <div class="section-heading">
        <div>
            <p class="eyebrow">A SETTING FOR EVERY OCCASION</p>
            <h2>Find your kind of evening.</h2>
        </div>
        <p class="muted">Intimate tables. Open-air moments. Private celebrations.</p>
    </div>
    <div class="space-grid">
        <article class="space-card">
            <img src="~/images/celeste-indoor.png" alt="Warm, curved walls surrounding intimate indoor dining tables" loading="lazy"/>
            <div>
                <h3>Indoor Dining</h3>
                <p>
                    A warm and intimate setting for 1–8 guests.
                    <br/>
                    Enjoy a two-hour dining experience.
                </p>
                <a asp-page="/Reservations/Create" asp-route-Area="Indoor">
                    Reserve indoors
                    <span aria-hidden="true">→</span>
                </a>
            </div>
        </article>
        <article class="space-card">
            <img src="~/images/celeste-outdoor.jpg" alt="An outdoor dining terrace overlooking the sunset" loading="lazy"/>
            <div>
                <h3>Outdoor Dining</h3>
                <p>
                    An open-air evening for 1–8 guests.
                    <br/>
                    Enjoy a two-hour dining experience.
                </p>
                <a asp-page="/Reservations/Create" asp-route-Area="Outdoor">
                    Reserve outdoors
                    <span aria-hidden="true">→</span>
                </a>
            </div>
        </article>
        <article class="space-card">
            <img src="~/images/celeste-private-dining.png" alt="A private dining room with a beautifully set long table" loading="lazy"/>
            <div>
                <h3>Private Dining</h3>
                <p>
                    A room of your own for 6–12 guests.
                    <br/>
                    Reserved from your arrival until closing.
                </p>
                <a asp-page="/Reservations/Create" asp-route-Area="VIP Room" asp-route-PartySize="6">
                    Reserve VIP room
                    <span aria-hidden="true">→</span>
                </a>
            </div>
        </article>
    </div>
</section>
@if (Model.Announcements.Count > 0)
{
    <section class="celeste-announcements" id="announcements" aria-labelledby="announcements-heading">
        <div class="section-heading">
            <div>
                <p class="eyebrow">NEWS FROM CÉLESTE</p>
                <h2 id="announcements-heading">Announcements</h2>
            </div>
            <p class="muted">Missed the welcome message? You can always read our latest news here.</p>
        </div>
        @if (Model.Announcements.Count > 1)
        {
            <div class="announcement-carousel-actions" aria-label="Browse announcements">
                <span class="muted">Swipe or use the arrows to read more.</span>
                <button type="button" class="announcement-carousel-arrow" data-announcement-prev
                        aria-controls="celeste-announcement-track" aria-label="Previous announcements">←</button>
                <button type="button" class="announcement-carousel-arrow" data-announcement-next
                        aria-controls="celeste-announcement-track" aria-label="Next announcements">→</button>
            </div>
        }
        <div class="celeste-announcement-list @(Model.Announcements.Count == 1 ? "single" : "")" id="celeste-announcement-track"
             tabindex="0" role="region" aria-label="Latest announcements, horizontally scrollable">
            @foreach (var announcement in Model.Announcements)
            {
                <article class="celeste-announcement">
                    @if (announcement.ExpiresAt.HasValue)
                    {
                        var remaining = Math.Max(1, (announcement.ExpiresAt.Value.Date - Model.Today).Days);
                        <span class="expiry-badge">@(remaining == 1 ? "1 day left" : $"{remaining} days left")</span>
                    }
                    <p class="eyebrow">@(announcement.IsPinned ? "PINNED · " : "")@(announcement.IsPromotional ? "PROMOTION · " : "")@announcement.CreatedAt.ToString("dd MMM yyyy")</p>
                    <h3>@announcement.Title</h3>
                    <p>@announcement.Message</p>
                </article>
            }
        </div>
    </section>
    @if (Model.PopupAnnouncements.Count > 0)
    {
    <dialog id="celeste-announcement-dialog" class="celeste-announcement-dialog" aria-labelledby="celeste-announcement-title">
        <div class="celeste-announcement-dialog-body">
            <p class="eyebrow">A NOTE FROM CÉLESTE</p>
            <h2 id="celeste-announcement-title">What's new at Céleste</h2>
            <div class="celeste-announcement-dialog-items">
                @foreach (var announcement in Model.PopupAnnouncements)
                {
                    <article data-announcement-id="@announcement.AnnouncementID" class="celeste-announcement-dialog-item">
                        <h3>@announcement.Title</h3>
                        <p>@announcement.Message</p>
                    </article>
                }
            </div>
            <form method="dialog" class="celeste-announcement-dialog-actions">
                <a href="#announcements" class="text-link" id="celeste-announcements-later">Read again later</a>
                <button type="submit" class="button">Dismiss</button>
            </form>
        </div>
    </dialog>
    }
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const track = document.getElementById('celeste-announcement-track');
            const previous = document.querySelector('[data-announcement-prev]');
            const next = document.querySelector('[data-announcement-next]');
            const controls = document.querySelector('.announcement-carousel-actions');
            if (track) {
                const updateArrows = () => {
                    if (controls) controls.hidden = track.scrollWidth <= track.clientWidth + 2;
                    const atStart = track.scrollLeft <= 2;
                    const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
                    if (previous) previous.disabled = atStart;
                    if (next) next.disabled = atEnd;
                };
                const advance = direction => {
                    const first = track.querySelector('.celeste-announcement');
                    if (!first) return;
                    const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
                    track.scrollBy({ left: direction * (first.getBoundingClientRect().width + gap), behavior: 'smooth' });
                };
                previous?.addEventListener('click', () => advance(-1));
                next?.addEventListener('click', () => advance(1));
                track.addEventListener('scroll', updateArrows, { passive: true });
                window.addEventListener('resize', updateArrows);
                updateArrows();
            }
            const dialog = document.getElementById("celeste-announcement-dialog");
            if (!dialog || typeof dialog.showModal !== "function") return;
            const key = "celeste-dismissed-announcements-v1";
            let dismissed = [];
            try {
                const saved = JSON.parse(window.localStorage.getItem(key) || "[]");
                if (Array.isArray(saved)) dismissed = saved.map(String);
            } catch (_) { /* Storage may be disabled by the browser. */ }
            const dismissedIds = new Set(dismissed);
            const items = Array.from(dialog.querySelectorAll("[data-announcement-id]"));
            const freshItems = items.filter(item => !dismissedIds.has(item.dataset.announcementId));
            items.forEach(item => { item.hidden = !freshItems.includes(item); });
            if (!freshItems.length) return;
            dialog.addEventListener("close", function () {
                freshItems.forEach(item => dismissedIds.add(item.dataset.announcementId));
                try { window.localStorage.setItem(key, JSON.stringify(Array.from(dismissedIds))); }
                catch (_) { /* Announcements remain readable on the homepage. */ }
            });
            dialog.showModal();
            document.getElementById("celeste-announcements-later")?.addEventListener("click", function () {
                dialog.close();
                window.location.hash = "announcements";
            });
        });
    </script>
}
@if (Model.Popular.Count > 0)
{
    <section class="dining-spaces">
        <div class="section-heading">
            <div>
                <p class="eyebrow">FROM OUR KITCHEN</p>
                <h2>Guest favourites</h2>
            </div>
            <a class="button secondary" asp-page="/Menu">View full menu →</a>
        </div>
        <div class="dish-grid">
            @foreach (var item in Model.Popular)
            {
                <article class="dish">
                    <div class="dish-art">
                        @if (MenuPricing.IsPromotionActive(item, ReservationPolicy.Now) && item.PromotionEndDate.HasValue)
                        {
                            var remaining = Math.Max(1, (item.PromotionEndDate.Value.Date - Model.Today).Days + 1);
                            <span class="expiry-badge">@(remaining == 1 ? "1 day left" : $"{remaining} days left")</span>
                        }
                        <img src="@MenuImages.Url(item)" alt="@MenuImages.Alt(item)" loading="lazy"
                             onerror="this.onerror=null; this.src='/images/celeste-indoor.png'; this.alt='Dining at Céleste';" />
                    </div>
                    <div class="dish-body">
                        <div class="dish-title">
                            <h3>@item.Name</h3>
                            @if (item.IsPopular)
                            {
                                <span class="badge">Popular</span>
                            }
                        </div>
                        <p>@item.Description</p>
                        <div class="dish-bottom">
                            @if (MenuPricing.IsPromotionActive(item, ReservationPolicy.Now))
                            {
                                <span class="price">RM @MenuPricing.CurrentPrice(item, ReservationPolicy.Now).ToString("0.00")</span>
                                <del class="muted">RM @item.Price.ToString("0.00")</del>
                            }
                            else
                            {
                                <span class="price">RM @item.Price.ToString("0.00")</span>
                            }
                            <a asp-page="/Menu" asp-route-q="@item.Name">Order →</a>
                        </div>
                    </div>
                </article>
            }
        </div>
    </section>
}
<section class="home-reserve">
    <p class="eyebrow">YOUR NEXT OCCASION</p>
    <h2>
        Good food deserves
        <br/>
        <em>
            great company.
        </em>
    </h2>
    <p>
        RM50 per guest secures your reservation and is deducted from your final bill.
        <br/>
        Private rooms have a minimum spend of RM2,400 for 6–8 guests or RM3,600 for 9–12 guests.
    </p>
    <a class="button" asp-page="/Reservations/Create">
        Reserve your table
    </a>
</section>


@page
@* Administrator dashboard: period figures, popular dishes, menu availability and announcements. *@
@model RROMS.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin dashboard";
}
<p class="eyebrow">ADMINISTRATOR WORKSPACE</p>
<h1>Overview &amp; Analytics</h1>
<p>A snapshot of reservations, dining orders and menu performance for the selected period.</p>
@if (TempData["Success"] is string ok)
{
    <p class="success">@ok</p>
}
@if (TempData["Error"] is string err)
{
    <p class="error">@err</p>
}
@{
    var periodToday = ReservationPolicy.Now.Date;
    var periodWeek = periodToday.AddDays(-(((int)periodToday.DayOfWeek + 6) % 7));
    var periodMonth = new DateTime(periodToday.Year, periodToday.Month, 1);
}
<div class="report-period-presets">
    <span>Quick periods:</span>
    <a asp-page="/Admin/Index" asp-route-from="@periodToday.ToString("yyyy-MM-dd")" asp-route-to="@periodToday.ToString("yyyy-MM-dd")">Today</a>
    <a asp-page="/Admin/Index" asp-route-from="@periodWeek.ToString("yyyy-MM-dd")" asp-route-to="@periodToday.ToString("yyyy-MM-dd")">This Week</a>
    <a asp-page="/Admin/Index" asp-route-from="@periodMonth.ToString("yyyy-MM-dd")" asp-route-to="@periodToday.ToString("yyyy-MM-dd")">This Month</a>
</div>
<form method="get" class="filters dashboard-filters">
    <label for="from">From</label>
    <input id="from" type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" />
    <label for="to">To</label>
    <input id="to" type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" />
    <button type="submit">Apply dates</button>
    <a class="button secondary" asp-page="Index">Reset</a>
    <a class="button secondary" asp-page-handler="Export" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")">Export CSV</a>
</form>
<div class="staff-stats">
    <section class="card">
        <small>ORDER SALES</small>
        <h2>RM @Model.OrderSales.ToString("N2")</h2>
        <p>Placed orders including tax, excluding cancelled</p>
    </section>
    <section class="card">
        <small>ORDERS</small>
        <h2>@Model.OrderCount</h2>
        <p>Dine-in orders in the period</p>
    </section>
    <section class="card">
        <small>RESERVATIONS</small>
        <h2>@Model.ReservationCount</h2>
        <p>Bookings dated in the period</p>
    </section>
    <section class="card">
        <small>REGISTERED CUSTOMERS</small>
        <h2>@Model.CustomerCount</h2>
        <p>All customer accounts</p>
    </section>
</div>
<section class="card dashboard-popular-menu">
    <div class="dashboard-popular-heading">
        <div>
            <h2>Popular menu items</h2>
            <p class="muted">Top dishes by quantity ordered within the selected period. Sales use the original order-line amounts.</p>
        </div>
        <a class="button" asp-page="/Admin/MenuManagement"
           asp-route-StartDate="@Model.From.ToString("yyyy-MM-dd")"
           asp-route-EndDate="@Model.To.ToString("yyyy-MM-dd")">Open Menu Management</a>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Dish</th>
                    <th>Quantity</th>
                    <th>Gross sales</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model.Popular)
                {
                    <tr>
                        <td>@x.Name</td>
                        <td>@x.Quantity</td>
                        <td>RM @x.Sales.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Popular.Any())
        {
            <p class="empty-state">No orders in this period.</p>
        }
    </div>
</section>
@if (Model.Insights is { } insights)
{
    <section class="staff-stats">
        <article class="card">
            <small>ACTIVE DINING CUSTOMERS</small>
            <h2>@insights.ActiveCustomers</h2>
            <p>Unique customers with active reservations in the period</p>
        </article>
        <article class="card">
            <small>RETURNING CUSTOMERS</small>
            <h2>@insights.ReturningCustomers</h2>
            <p>Customers with at least two valid reservations</p>
        </article>
        <article class="card">
            <small>AVERAGE PARTY SIZE</small>
            <h2>@insights.AveragePartySize.ToString("N1")</h2>
            <p>Guests per valid reservation</p>
        </article>
        <article class="card">
            <small>SCHEDULED TABLE USE</small>
            <h2>@(Model.Occupancy == null ? "—" : Model.Occupancy.UtilisationPercent.ToString("N1") + "%")</h2>
            <p>Planned utilisation (up to 90-day report periods)</p>
        </article>
    </section>

    <div class="grid">
        <section class="card">
            <h2>Customer Behaviour</h2>
            <p class="muted">Confirmed, seated and completed reservations scheduled within the period.</p>
            <div class="analytics-summary-row"><span>First-time customers</span><strong>@insights.NewCustomers</strong></div>
            <div class="analytics-summary-row"><span>Returning customers</span><strong>@insights.ReturningCustomers</strong></div>
            <div class="analytics-summary-row"><span>Average party size</span><strong>@insights.AveragePartySize.ToString("N1") guests</strong></div>
            <div class="analytics-summary-row"><span>Average dining spend per completed reservation</span><strong>@(insights.SettledCompletedReservations == 0 ? "—" : "RM " + insights.AverageDiningSpendPerCompletedReservation.ToString("N2"))</strong></div>
            <div class="analytics-summary-row"><span>Average spend per guest</span><strong>@(insights.SettledCompletedReservations == 0 ? "—" : "RM " + insights.AverageSpendPerGuest.ToString("N2"))</strong></div>
            <p class="muted">Spending averages use paid final bills for completed dining visits, including any applicable minimum spend and tax. Deposits are not counted twice.</p>
            <p class="muted">First-time means the customer’s first valid reservation falls within the selected dates. Returning means they had a valid reservation before the period began.</p>
            <a asp-page="/Admin/ReportReservations" asp-route-StartDate="@Model.From.ToString("yyyy-MM-dd")" asp-route-EndDate="@Model.To.ToString("yyyy-MM-dd")">Explore reservations</a>
        </section>
        <section class="card">
            <p class="eyebrow">MENU INSIGHTS</p>
            <h2>Manage Menu &amp; Performance</h2>
            <p class="muted">See which dishes are performing best and which may need attention during this reporting period.</p>
            <div class="analytics-summary-row">
                <span>Most ordered dish</span>
                <strong>@(Model.MostOrderedDish is null ? "No orders" : $"{Model.MostOrderedDish.Name} ({Model.MostOrderedDish.Units:N0} units)")</strong>
            </div>
            <div class="analytics-summary-row">
                <span>Highest sales dish</span>
                <strong>@(Model.HighestSalesDish is null ? "No sales" : $"{Model.HighestSalesDish.Name} (RM {Model.HighestSalesDish.Sales:N2})")</strong>
            </div>
            <div class="analytics-summary-row">
                <span>Dishes with zero orders</span>
                <strong>@Model.ZeroOrderDishCount</strong>
            </div>
            @if (Model.ZeroOrderDishCount > 0)
            {
                <p class="muted">To review: @string.Join(", ", Model.ZeroOrderDishNames.Take(3))@(Model.ZeroOrderDishCount > 3 ? "…" : "")</p>
            }
            <p class="muted">Figures exclude cancelled orders and dishes. Zero-order dishes are currently available menu items.</p>
            <a class="button" asp-page="/Admin/MenuManagement"
               asp-route-StartDate="@Model.From.ToString("yyyy-MM-dd")"
               asp-route-EndDate="@Model.To.ToString("yyyy-MM-dd")">Open Menu Workspace</a>
        </section>
    </div>


    <div class="analytics-links">
        <a class="button secondary" asp-page="/Admin/Reports">Reservation &amp; Deposit Reports</a>
        <a class="button secondary" asp-page="/Admin/PaymentCollections">Payment Collections</a>
        <a class="button secondary" asp-page="/Admin/Occupancy">Occupancy Details</a>
        <a class="button secondary" asp-page="/Admin/MenuManagement">Menu Workspace</a>
    </div>
}
<section class="card announcement-admin-panel">
    <div class="announcement-panel-heading">
        <h2>Announcements</h2>
        <p class="muted">Manage your published messages here. The outline pin becomes filled when pinned. Pinned regular announcements appear first in customer news, and pinned promotions are prioritised in the pop-up. Featuring controls the separate homepage banner.</p>
    </div>
    <div class="announcement-entry-list">
        @foreach (var a in Model.Announcements)
        {
            var expired = a.ExpiresAt.HasValue && a.ExpiresAt.Value <= Model.CurrentTime;
            var scheduled = a.StartsAt.HasValue && a.StartsAt.Value > Model.CurrentTime;
            var expiryText = !a.ExpiresAt.HasValue ? "No scheduled expiry"
                : $"Through {a.ExpiresAt.Value.AddDays(-1):dd MMM yyyy}";
            var selectedEndDate = a.ExpiresAt?.Date;
            if (a.DurationMode == "custom" && selectedEndDate.HasValue)
                selectedEndDate = selectedEndDate.Value.AddDays(-1);
            <article class="announcement-entry @(a.IsPinned ? "is-pinned" : "")">
                <div class="announcement-entry-top">
                    <div class="announcement-entry-copy">
                        <div class="announcement-entry-title-row">
                            <h3>@a.Title</h3>
                            @if (a.IsPromotional)
                            {
                                <span class="announcement-entry-badge">Promotion</span>
                            }
                            @if (a.IsPinned)
                            {
                                <span class="announcement-entry-badge pinned">Pinned</span>
                            }
                        </div>
                        <p>@a.Message</p>
                        <small class="@(expired ? "announcement-expired" : "muted")">
                            @(expired ? "Expired" : scheduled ? "Scheduled" : "Visible") · @expiryText
                        </small>
                    </div>
                    <form method="post" asp-page-handler="SetAnnouncementPin">
                        <input type="hidden" name="id" value="@a.AnnouncementID" />
                        <input type="hidden" name="isPinned" value="@(a.IsPinned ? "false" : "true")" />
                        <button type="submit" class="announcement-pin-toggle @(a.IsPinned ? "is-pinned" : "")"
                                aria-label="@(a.IsPinned ? "Unpin announcement" : "Pin announcement to top")"
                                aria-pressed="@(a.IsPinned ? "true" : "false")"
                                title="@(a.IsPinned ? "Unpin announcement" : "Pin to top")">
                            <svg viewBox="0 0 24 24" fill="@(a.IsPinned ? "currentColor" : "none")"
                                 stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"
                                 aria-hidden="true" focusable="false">
                                <path d="M8 3h8l-1 2v5l3 3v2H6v-2l3-3V5L8 3Z" />
                                <path d="M12 15v7" stroke-linecap="round" fill="none" />
                            </svg>
                        </button>
                    </form>
                </div>
                <div class="announcement-entry-settings">
                    <form method="post" asp-page-handler="SetAnnouncementDisplay" class="announcement-entry-display-form">
                        <input type="hidden" name="id" value="@a.AnnouncementID" />
                        <div class="announcement-entry-field-title">Where it appears</div>
                        <div class="announcement-entry-checks">
                            <label><input type="checkbox" name="showInPopup" value="true" checked="@a.ShowInPopup" /> Welcome pop-up</label>
                            <label><input type="checkbox" name="isFeatured" value="true" checked="@a.IsFeatured" /> Featured banner</label>
                        </div>
                        <p class="announcement-entry-hint">Pop-up can be dismissed; banner stays until expiry.</p>
                        <button type="submit" class="secondary">SAVE DISPLAY</button>
                    </form>
                    <form method="post" asp-page-handler="SetAnnouncementExpiry"
                          class="announcement-entry-duration-form" data-announcement-duration-form>
                        <input type="hidden" name="id" value="@a.AnnouncementID" />
                        <label class="announcement-entry-field-title" for="duration-@a.AnnouncementID">Display for</label>
                        <div class="announcement-entry-duration-controls">
                            <select id="duration-@a.AnnouncementID" name="duration" data-announcement-duration>
                                <option value="1" selected="@(a.DurationMode == "1")">1 day (including today)</option>
                                <option value="7" selected="@(a.DurationMode == "7")">7 days (including today)</option>
                                <option value="30" selected="@(a.DurationMode == "30")">30 days (including today)</option>
                                <option value="custom" selected="@(a.DurationMode == "custom")">Until a date</option>
                                <option value="never" selected="@(a.DurationMode == "never")">No expiry</option>
                            </select>
                            <button type="submit" class="secondary">SAVE DURATION</button>
                        </div>
                        <label class="announcement-expiry-picker announcement-entry-end-date"
                               for="end-@a.AnnouncementID" data-custom-end>
                            End date (inclusive)
                            <input id="end-@a.AnnouncementID" type="date" name="endDate"
                                   min="@Model.CurrentTime.ToString("yyyy-MM-dd")"
                                   value="@(selectedEndDate?.ToString("yyyy-MM-dd"))" />
                        </label>
                    </form>
                </div>
                <div class="announcement-entry-footer">
                    <span class="muted">@(a.IsPromotional ? "Promotional campaign" : "Customer announcement")</span>
                    <form method="post" asp-page-handler="RetireAnnouncement"
                          onsubmit="return confirm('Remove this announcement? It will no longer appear to customers.');">
                        <input type="hidden" name="id" value="@a.AnnouncementID" />
                        <button type="submit" class="announcement-entry-remove">REMOVE</button>
                    </form>
                </div>
            </article>
        }
    </div>
    @if (!Model.Announcements.Any())
    {
        <p class="muted">No active or scheduled announcements.</p>
    }
    <div class="announcement-publish-heading">
        <h2>Publish announcement</h2>
        <p class="muted">New announcements appear in both the welcome pop-up and the featured banner by default. You can change either option before publishing.</p>
    </div>
    <form method="post" asp-page-handler="Announcement" class="announcement-publish-form"
          data-announcement-duration-form>
        <label for="title">Title</label>
        <input id="title" name="title" maxlength="120" required />
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="3" maxlength="1000" required></textarea>
        <div class="announcement-duration-fields">
            <div>
                <label for="announcement-duration">Display for</label>
                <select id="announcement-duration" name="duration" data-announcement-duration required>
                    <option value="1">1 day (including today)</option>
                    <option value="7" selected>7 days (including today)</option>
                    <option value="30">30 days (including today)</option>
                    <option value="custom">Until a date</option>
                    <option value="never">No expiry (until removed)</option>
                </select>
            </div>
            <label for="announcement-end" class="announcement-expiry-picker" data-custom-end>
                End date (inclusive)
                <input id="announcement-end" type="date" name="endDate"
                       min="@Model.CurrentTime.ToString("yyyy-MM-dd")" />
            </label>
        </div>
        <div class="announcement-duration-fields">
            <label><input type="checkbox" name="showInPopup" value="true" checked /> Show in the welcome pop-up</label>
            <label><input type="checkbox" name="isFeatured" value="true" checked /> Feature above dining spaces</label>
        </div>
        <p class="muted">The welcome pop-up is dismissible. The featured banner stays on the homepage until expiry. Only one announcement can be featured at a time.</p>
        <button type="submit">Publish</button>
    </form>
</section>

@section Scripts {
    <script>
        document.querySelectorAll('[data-announcement-duration-form]').forEach(function (form) {
            const select = form.querySelector('[data-announcement-duration]');
            const custom = form.querySelector('[data-custom-end]');
            const picker = custom?.querySelector('input[type="date"]');
            if (!select || !custom || !picker) return;
            const update = () => {
                const selected = select.value === 'custom';
                custom.hidden = !selected;
                picker.required = selected;
                picker.disabled = !selected;
            };
            select.addEventListener('change', update);
            update();
        });
    </script>
}

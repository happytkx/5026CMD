@page
@model RROMS.Pages.Admin.AccountDetailsModel
@{
    ViewData["Title"] = "Account Profile";
    var name = Model.IsCustomer ? Model.CustomerProfile!.CustomerName : Model.StaffProfile!.StaffName;
    var email = Model.IsCustomer ? Model.CustomerProfile!.Email : Model.StaffProfile!.Email;
    var active = Model.IsCustomer ? Model.CustomerProfile!.IsActive : Model.StaffProfile!.IsActive;
    var directoryTab = Model.IsCustomer ? "customers" : "staff";
}
<style>
    .profile-head { display: flex; justify-content: space-between; align-items: start; gap: 1.5rem; flex-wrap: wrap; }
    .profile-head h1 { margin: .35rem 0; }
    .profile-head p { margin: .25rem 0; }
    .profile-actions { display: flex; gap: .6rem; align-items: center; flex-wrap: wrap; }
    .profile-actions form { margin: 0; }
    .profile-danger { background: #ab3333 !important; border: 1px solid #ab3333 !important; color: #fff !important; }
    .profile-danger:hover { background: #872525 !important; }
    .profile-status { border-radius: 99px; padding: .25rem .7rem; background: #e8eddf; color: #344a2b; font-size: .82rem; }
    .profile-status.inactive { background: #f1e8e2; color: #854737; }
    .profile-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .9rem; margin: 1.5rem 0; }
    .profile-stats .card { padding: 1.2rem; }
    .profile-stats small { display: block; color: #716b60; font-size: .75rem; letter-spacing: .05em; text-transform: uppercase; }
    .profile-stats strong { display: block; font: 600 2rem var(--heading); margin-top: .4rem; color: #34372c; }
    .profile-details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.2rem; margin: 1rem 0 0; }
    .profile-details dt { font-size: .79rem; text-transform: uppercase; letter-spacing: .06em; color: #777066; }
    .profile-details dd { margin: .35rem 0 0; overflow-wrap: anywhere; font-weight: 600; }
    .profile-edit { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
    .profile-edit label { display: block; margin-bottom: .35rem; font-weight: 600; }
    .profile-edit input, .profile-edit textarea { width: 100%; }
    .profile-edit .profile-wide { grid-column: 1 / -1; }
    .profile-table { width: 100%; border-collapse: collapse; }
    .profile-table th, .profile-table td { padding: .8rem; border-bottom: 1px solid #e5ded2; text-align: left; vertical-align: top; }
    .profile-table th { background: #eee9df; font-size: .75rem; letter-spacing: .04em; text-transform: uppercase; }
    .profile-table td { font-size: .88rem; }
    .profile-table td small { display: block; margin-top: .25rem; color: #716b60; }
    .profile-table .reference { overflow-wrap: anywhere; }
    .profile-table .profile-status { display: inline-block; }
    .profile-favourites { display: flex; flex-wrap: wrap; gap: .55rem; list-style: none; padding: 0; }
    .profile-favourites li { background: #edf0e5; border-radius: 4px; padding: .5rem .7rem; }
    .profile-review { border-top: 1px solid #e5ded2; padding: 1rem 0; }
    .profile-review small { margin-left: .8rem; color: #716b60; }
    .profile-review p { margin: .4rem 0 0; }
    .profile-section-heading { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
    .profile-section-heading small { color: #716b60; }
    @@media (max-width: 820px) { .profile-stats { grid-template-columns: repeat(2, 1fr); } .profile-edit, .profile-details { grid-template-columns: 1fr; } }
</style>
<p class="eyebrow">ADMINISTRATOR / ACCOUNT PROFILE</p>
<p><a asp-page="/Admin/StaffAccounts" asp-route-tab="@directoryTab">&larr; Back to @directoryTab directory</a></p>

@if (TempData["AccountProfileSuccess"] is string success)
{ <p class="success" role="status">@success</p> }
@if (TempData["AccountProfileError"] is string error)
{ <p class="error" role="alert">@error</p> }

<section class="card">
    <div class="profile-head">
        <div>
            <p class="eyebrow">@(Model.IsCustomer ? "CUSTOMER PROFILE" : "STAFF PROFILE")</p>
            <h1>@name</h1>
            <p>@email</p>
            <span class="profile-status @(active ? "" : "inactive")">@(active ? "Active" : "Deactivated")</span>
        </div>
        <div class="profile-actions">
            @if (Model.Edit)
            {
                <a class="button secondary" asp-page="/Admin/AccountDetails" asp-route-type="@Model.Type" asp-route-id="@Model.Id">CANCEL EDIT</a>
            }
            else
            {
                <a class="button secondary" asp-page="/Admin/AccountDetails" asp-route-type="@Model.Type" asp-route-id="@Model.Id" asp-route-edit="true">EDIT ACCOUNT</a>
            }
            <form method="post" asp-page-handler="SetActive"
                  onsubmit="return confirm('@(active ? "Deactivate this account and revoke its sessions?" : "Reactivate this account?")');">
                <input type="hidden" name="type" value="@Model.Type" />
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="isActive" value="@(active ? "false" : "true")" />
                <button type="submit" class="@(active ? "profile-danger" : "secondary")">@(active ? "DEACTIVATE" : "REACTIVATE")</button>
            </form>
        </div>
    </div>
    @if (Model.Edit)
    {
        <hr />
        <h2>Edit account details</h2>
        <p class="muted">Changes are applied only when you click Save changes. Leave the password blank to keep the current one.</p>
        <form method="post" asp-page-handler="Save">
            <input type="hidden" name="type" value="@Model.Type" />
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="profile-edit">
                <div><label for="profile-name">Name</label><input id="profile-name" name="name" value="@name" maxlength="100" required /></div>
                <div><label for="profile-email">Email</label><input id="profile-email" type="email" name="email" value="@email" maxlength="100" required /></div>
                @if (Model.IsCustomer)
                {
                    <div><label for="profile-phone">Phone number</label><input id="profile-phone" name="phoneNo" value="@Model.CustomerProfile!.PhoneNo" maxlength="20" /></div>
                    <div><label for="profile-address">Address</label><textarea id="profile-address" name="address" maxlength="250" rows="2">@Model.CustomerProfile!.Address</textarea></div>
                }
                <div class="profile-wide"><label for="profile-password">New password (optional)</label>
                    <input id="profile-password" type="password" name="newPassword" minlength="10" maxlength="128" autocomplete="new-password" placeholder="Leave blank to keep current password" /></div>
            </div>
            <button type="submit">SAVE CHANGES</button>
        </form>
    }
    else
    {
        <dl class="profile-details">
            <div><dt>Account type</dt><dd>@(Model.IsCustomer ? "Customer" : "Restaurant Staff")</dd></div>
            <div><dt>Account ID</dt><dd>@Model.Id</dd></div>
            @if (Model.IsCustomer)
            {
                <div><dt>Phone</dt><dd>@(string.IsNullOrWhiteSpace(Model.CustomerProfile!.PhoneNo) ? "Not provided" : Model.CustomerProfile.PhoneNo)</dd></div>
                <div><dt>Address</dt><dd>@(string.IsNullOrWhiteSpace(Model.CustomerProfile!.Address) ? "Not provided" : Model.CustomerProfile.Address)</dd></div>
                <div><dt>Account created</dt><dd>@Model.CustomerProfile!.CreatedAt.ToString("dd MMM yyyy")</dd></div>
                <div><dt>Login availability</dt><dd>@(Model.CustomerProfile!.PasswordHash is null ? "Reservation-only record" : "Password login configured")</dd></div>
            }
        </dl>
    }
</section>

@if (Model.IsCustomer)
{
    <div class="profile-stats">
        <div class="card"><small>Completed visits</small><strong>@Model.CompletedVisits</strong></div>
        <div class="card"><small>Total reservations</small><strong>@Model.TotalReservations</strong></div>
        <div class="card"><small>Dining orders</small><strong>@Model.TotalOrders</strong></div>
        <div class="card"><small>Paid dining bills</small><strong>RM @Model.TotalPaidDining.ToString("N2")</strong></div>
    </div>

    <section class="card">
        <div class="profile-section-heading"><h2>Frequently ordered dishes</h2><small>Top 5 by quantity</small></div>
        @if (Model.FavouriteDishes.Count == 0)
        { <p class="muted">No dishes ordered yet.</p> }
        else
        {
            <ul class="profile-favourites">
                @foreach (var dish in Model.FavouriteDishes)
                { <li>@dish.Name <strong>× @dish.Quantity</strong></li> }
            </ul>
        }
    </section>

    <section class="card">
        <div class="profile-section-heading"><h2>Customer reviews</h2><small>Latest @Model.CustomerReviews.Count reviews</small></div>
        @if (Model.CustomerReviews.Count == 0)
        { <p class="muted">No reviews submitted yet.</p> }
        else
        {
            @foreach (var review in Model.CustomerReviews)
            {
                <div class="profile-review">
                    <strong>@review.Rating / 5 stars</strong>
                    <small>@review.CreatedAt.ToString("dd MMM yyyy") · @(review.OrderID.HasValue ? "Order review" : "General feedback")</small>
                    <p>@review.Comment</p>
                </div>
            }
        }
    </section>

    <section class="card">
        <div class="profile-section-heading"><h2>Reservation history</h2><small>Showing latest @Model.Reservations.Count of @Model.TotalReservations</small></div>
        <div class="table-wrap">
            <table class="profile-table">
                <thead><tr><th>Date</th><th>Reference</th><th>Party</th><th>Area / Table</th><th>Status</th><th>Details</th></tr></thead>
                <tbody>
                    @foreach (var reservation in Model.Reservations)
                    {
                        <tr>
                            <td>@reservation.ReservationDate.ToString("dd MMM yyyy")<small>@reservation.ReservationDate.Add(reservation.StartTime).ToString("h:mm tt")</small></td>
                            <td class="reference">@reservation.BookingReference</td>
                            <td>@reservation.PartySize</td>
                            <td>@reservation.PreferredDiningOption<small>@reservation.TableID</small></td>
                            <td><span class="profile-status">@reservation.ReservationStatus</span></td>
                            <td><a asp-page="/Reservations/Details" asp-route-id="@reservation.ReservationID">View booking</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Reservations.Count == 0) { <p class="muted">No reservations yet.</p> }
    </section>

    <section class="card">
        <div class="profile-section-heading"><h2>Dining order history</h2><small>Showing latest @Model.Orders.Count of @Model.TotalOrders</small></div>
        <div class="table-wrap">
            <table class="profile-table">
                <thead><tr><th>Date</th><th>Order</th><th>Dishes ordered</th><th>Status</th><th>Total</th></tr></thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td>@order.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td class="reference">@order.Reference</td>
                            <td>
                                @foreach (var line in order.Lines.Where(l => !l.IsCancelled))
                                { <div>@line.Quantity × @line.ItemName</div> }
                            </td>
                            <td><span class="profile-status">@order.Status</span></td>
                            <td><strong>RM @order.Total.ToString("N2")</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Orders.Count == 0) { <p class="muted">No dining orders yet.</p> }
    </section>
}

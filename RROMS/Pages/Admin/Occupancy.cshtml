
@page
@model RROMS.Pages.Admin.OccupancyModel

@{
    ViewData["Title"] = "Table Utilisation Analytics";
}

<p class="eyebrow">REPORTING & ANALYTICS</p>

<h1>Table Utilisation & Peak Hours</h1>

<p>
    Analyse scheduled table use, dining-area demand,
    and reservation arrival patterns.
</p>

@{
    var quickToday = ReservationPolicy.Now.Date;
    var quickWeek = quickToday.AddDays(-(((int)quickToday.DayOfWeek + 6) % 7));
    var quickMonth = new DateTime(quickToday.Year, quickToday.Month, 1);
}
<div class="report-period-presets">
    <span>Quick periods:</span>
    <a asp-page="/Admin/Occupancy" asp-route-StartDate="@quickToday.ToString("yyyy-MM-dd")" asp-route-EndDate="@quickToday.ToString("yyyy-MM-dd")">Today</a>
    <a asp-page="/Admin/Occupancy" asp-route-StartDate="@quickWeek.ToString("yyyy-MM-dd")" asp-route-EndDate="@quickToday.ToString("yyyy-MM-dd")">This Week</a>
    <a asp-page="/Admin/Occupancy" asp-route-StartDate="@quickMonth.ToString("yyyy-MM-dd")" asp-route-EndDate="@quickToday.ToString("yyyy-MM-dd")">This Month</a>
</div>
<form method="get" class="report-period-form">
    <section class="card report-period-card">
        <h2>Select Reporting Period</h2>

        <div class="report-date-fields">

            <div class="report-date-field">
                <label asp-for="StartDate">Start Date</label>
                <input asp-for="StartDate" type="date" />
            </div>

            <div class="report-date-field">
                <label asp-for="EndDate">End Date</label>
                <input asp-for="EndDate" type="date" />
            </div>

        </div>

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="report-actions">
            <button type="submit" class="report-action-button">
                Generate Report
            </button>

            <button type="submit"
                    name="handler"
                    value="Export"
                    class="secondary report-action-button">
                Export Report (CSV)
            </button>
        </div>
    </section>
</form>

@if (Model.Report is { } report)
{
    <p>
        Reporting period:
        @report.StartDate.ToString("dd MMM yyyy")
        to
        @report.EndDate.ToString("dd MMM yyyy")
    </p>

    <section class="staff-stats">
        <a class="card occupancy-stat-link" asp-page="/Admin/ReportReservations"
           asp-route-StartDate="@report.StartDate.ToString("yyyy-MM-dd")"
           asp-route-EndDate="@report.EndDate.ToString("yyyy-MM-dd")"
           asp-route-Status="Scheduled"
           aria-label="View all scheduled reservations in Reservation Reports">
            <small>SCHEDULED RESERVATIONS</small>
            <h2>@report.ReservationCount</h2>
            <p class="stat-link-hint">View reservations →</p>
        </a>

        <article class="card">
            <small>RESERVED GUESTS</small>
            <h2>@report.GuestCount</h2>
        </article>

        <article class="card">
            <small>BOOKED TABLE-HOURS</small>
            <h2>@report.BookedHours.ToString("N2")</h2>
        </article>

        <article class="card">
            <small>SCHEDULED UTILISATION</small>
            <h2>@report.UtilisationPercent.ToString("N1")%</h2>
        </article>
    </section>

    <section class="card">
        <h2>Dining Area Performance</h2>

        <p>
            Compare scheduled reservations and table-hour
            utilisation across dining areas.
        </p>

        @if (report.Areas.Count == 0)
        {
            <p>No restaurant tables are configured.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Dining Area</th>
                            <th>Tables / Rooms</th>
                            <th>Reservations</th>
                            <th>Guests</th>
                            <th>Booked Hours</th>
                            <th>Available Hours</th>
                            <th>Utilisation</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var area in report.Areas)
                        {
                            <tr>
                                <td>@area.Area</td>
                                <td>@area.TableCount</td>
                                <td>@area.ReservationCount</td>
                                <td>@area.GuestCount</td>
                                <td>@area.BookedHours.ToString("N2")</td>
                                <td>@area.AvailableHours.ToString("N2")</td>
                                <td>
                                    @area.UtilisationPercent.ToString("N1")%
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="card report-chart">
        <h2>Peak Reservation Arrival Hours</h2>

        <p>
            Number of scheduled reservations beginning
            during each hour of operation.
        </p>

        @{
            var arrivalHours = report.ArrivalHours;
            var maxCount = arrivalHours.Count == 0 ? 0 : arrivalHours.Max(h => h.ReservationCount);
        }

        @if (maxCount == 0)
        {
            <p>No scheduled reservation arrivals were found for this period.</p>
        }
        else
        {
            string ChartCoord(double value) =>
                value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
            var points = arrivalHours.Select((hour, index) => new
            {
                hour.Hour,
                Count = hour.ReservationCount,
                Label = new DateTime(2000, 1, 1, hour.Hour, 0, 0).ToString("h:mm tt"),
                ShortLabel = new DateTime(2000, 1, 1, hour.Hour, 0, 0).ToString("h tt"),
                X = ChartCoord(arrivalHours.Count == 1 ? 498d :
                    60d + index * 875d / (arrivalHours.Count - 1)),
                Y = ChartCoord(245d - hour.ReservationCount * 215d / maxCount)
            }).ToList();
            var linePoints = string.Join(" ", points.Select(p => p.X + "," + p.Y));
            <p class="muted">Hover over a point, or focus it with the keyboard, to see the exact reservation count.</p>
            <div class="reservation-chart-interactive arrival-chart-interactive">
                <div class="reservation-line-chart">
                    <svg viewBox="0 0 975 310" role="img"
                         aria-labelledby="arrival-chart-title arrival-chart-description">
                        <title id="arrival-chart-title">Reservation arrival patterns by hour</title>
                        <desc id="arrival-chart-description">
                            Line chart of scheduled reservation arrivals from opening to closing.
                            Exact hourly counts are available in the breakdown below.
                        </desc>
                        @for (var tick = 0; tick <= 4; tick++)
                        {
                            var y = ChartCoord(245d - tick * 215d / 4d);
                            var value = (int)Math.Round(maxCount * tick / 4d);
                            <line class="reservation-chart-gridline" x1="60" y1="@y" x2="935" y2="@y"></line>
                            @Html.Raw($"<text class=\"reservation-chart-axis\" x=\"48\" y=\"{ChartCoord(245d - tick * 215d / 4d + 4d)}\" text-anchor=\"end\">{value}</text>")
                        }
                        <polyline class="reservation-chart-line" points="@linePoints"></polyline>
                        @foreach (var point in points)
                        {
                            <circle class="reservation-chart-point"
                                    cx="@point.X" cy="@point.Y" r="8" tabindex="0"
                                    data-chart-point data-chart-count="@point.Count"
                                    data-chart-hour="@point.Label"
                                    aria-label="@($"{point.Label}: {point.Count} scheduled reservations")"></circle>
                            @Html.Raw($"<text class=\"reservation-chart-axis reservation-chart-date\" x=\"{point.X}\" y=\"279\" text-anchor=\"middle\">{System.Net.WebUtility.HtmlEncode(point.ShortLabel)}</text>")
                        }
                    </svg>
                </div>
                <div class="reservation-chart-tooltip" role="tooltip" hidden>
                    <strong data-chart-tooltip-count></strong>
                    <span data-chart-tooltip-date></span>
                </div>
            </div>
            <details class="reservation-trend-data">
                <summary>View hourly breakdown</summary>
                @foreach (var hour in arrivalHours)
                {
                    var label = new DateTime(2000, 1, 1, hour.Hour, 0, 0).ToString("h:mm tt");
                    var percentage = (int)Math.Round(hour.ReservationCount * 100.0 / maxCount);
                    <div class="report-status-row">
                        <div class="report-status-label">
                            <strong>@label</strong>
                            <span>@hour.ReservationCount reservation@(hour.ReservationCount == 1 ? "" : "s")</span>
                        </div>
                        <div class="report-bar-track" role="progressbar"
                             aria-label="@label scheduled arrivals"
                             aria-valuemin="0" aria-valuemax="@maxCount"
                             aria-valuenow="@hour.ReservationCount">
                            <div class="report-bar-fill" style="width: @(percentage)%"></div>
                        </div>
                    </div>
                }
            </details>
        }
    </section>

    <p class="notice">
        This report estimates scheduled table utilisation
        from Confirmed, Seated and Completed reservations.

        It excludes Pending, Cancelled, No-show and
        Expired reservations.

        Utilisation is calculated as booked table-hours
        divided by available table-hours, using the
        currently configured table inventory and
        restaurant opening hours.

        These figures represent planned table use,
        not verified physical occupancy.
    </p>
}

@section Scripts {
    <script>
        document.querySelectorAll('.arrival-chart-interactive').forEach(container => {
            const tooltip = container.querySelector('.reservation-chart-tooltip');
            const count = tooltip?.querySelector('[data-chart-tooltip-count]');
            const hour = tooltip?.querySelector('[data-chart-tooltip-date]');
            if (!tooltip || !count || !hour) return;

            function show(point) {
                const total = Number(point.dataset.chartCount || 0);
                count.textContent = total + (total === 1 ? ' reservation' : ' reservations');
                hour.textContent = point.dataset.chartHour || '';
                tooltip.hidden = false;
                const frame = container.getBoundingClientRect();
                const target = point.getBoundingClientRect();
                const width = tooltip.offsetWidth;
                const height = tooltip.offsetHeight;
                const centerX = target.left + target.width / 2 - frame.left;
                const topY = target.top - frame.top - height - 14;
                tooltip.style.left = Math.max(8, Math.min(centerX - width / 2, frame.width - width - 8)) + 'px';
                tooltip.style.top = (topY >= 0 ? topY : target.bottom - frame.top + 12) + 'px';
            }

            function hide() { tooltip.hidden = true; }
            container.querySelectorAll('[data-chart-point]').forEach(point => {
                point.addEventListener('pointerenter', () => show(point));
                point.addEventListener('pointerleave', hide);
                point.addEventListener('focus', () => show(point));
                point.addEventListener('blur', hide);
            });
            container.querySelector('.reservation-line-chart')?.addEventListener('scroll', hide, { passive: true });
            window.addEventListener('resize', hide);
        });
    </script>
}

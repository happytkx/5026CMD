@page
@model RROMS.Pages.Admin.PromotionsModel
@{
    ViewData["Title"] = "Promotional Offers";
}
<style>
    .promotion-bulk-groups { max-height: 26rem; overflow-y: auto; padding: .5rem; margin: 1rem 0; border: 1px solid #e6ddd0; border-radius: .3rem; }
    .promotion-bulk-category { margin: .25rem 0 1.3rem; }
    .promotion-bulk-category:last-child { margin-bottom: .25rem; }
    .promotion-bulk-category h3 { font: 600 1.05rem var(--body); color: #6c7154; margin: .55rem 0; padding-bottom: .4rem; border-bottom: 1px solid #e6ddd0; }
    .promotion-bulk-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: .55rem; }
    .promotion-bulk-list label { display: flex; gap: .5rem; align-items: center; padding: .55rem .7rem; border: 1px solid #ded6c9; border-radius: .3rem; cursor: pointer; }
    .promotion-bulk-list label:has(input:checked) { background: #eeece3; border-color: #9a966f; }
    .promotion-bulk-fields { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .8rem; margin: 1rem 0; }
    .promotion-bulk-fields label { display: block; font-weight: 600; margin-bottom: .35rem; }
    .promotion-bulk-fields input { width: 100%; }
    .promotion-bulk-message { display: grid; gap: .65rem; margin: 1rem 0; }
    .promotion-bulk-message input[type=text], .promotion-bulk-message textarea { width: 100%; }
    .promotion-bulk-check { display: flex; gap: .55rem; align-items: center; font-weight: 500; }
    @@media (max-width: 750px) { .promotion-bulk-fields { grid-template-columns: 1fr; } }
    .promotion-overview { display: flex; gap: 1rem; flex-wrap: wrap; margin: 1.25rem 0; }
    .promotion-overview .card { min-width: 12rem; flex: 1; }
    .promotion-overview a.promotion-summary-button { text-decoration: none; }
    .promotion-overview strong { display: block; font-size: 1.8rem; }
    .promotion-item { padding: 1.5rem 0; border-bottom: 1px solid #e6ddd0; }
    .promotion-item:last-child { border-bottom: 0; }
    .promotion-heading { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .75rem; margin-bottom: .8rem; }
    .promotion-heading h3 { margin: 0; }
    .promotion-fields { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)) auto; gap: .8rem; align-items: end; }
    .promotion-fields label { display: block; font-weight: 600; margin-bottom: .35rem; }
    .promotion-fields input { width: 100%; }
    .promotion-fields button { min-height: 44px; }
    .promotion-tools { display: flex; gap: 1rem; align-items: center; margin-top: .65rem; }
    .promotion-status { border-radius: 999px; background: #efece3; padding: .25rem .75rem; }
    .promotion-status.active { background: #e0ecdd; color: #304f34; }
    .promotion-status.scheduled { background: #f3e7d5; color: #725325; }
    .promotion-price-note { color: #6c5b45; }
    @@media (max-width: 900px) { .promotion-fields { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    .promotion-category-list { display: grid; gap: 1rem; }
    .promotion-category-panel { border: 1px solid #ded6c9; border-radius: .4rem; background: #fff; padding: 0 1.15rem; }
    .promotion-category-panel[hidden] { display: none !important; }
    .promotion-category-heading { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: .6rem; margin: 0 -1.15rem .15rem; padding: 1rem 1.15rem; background: #f5f3ed; border-bottom: 1px solid #e6ddd0; }
    .promotion-category-heading h3 { margin: 0; color: #606d4c; font-size: 1.45rem; }
    .promotion-category-heading span { font-size: .8rem; color: #777167; }
    .promotion-category-tabs { margin: 1.4rem 0 1.2rem; }
    @@media (max-width: 520px) { .promotion-fields { grid-template-columns: 1fr; } }
</style>

<p class="eyebrow">ADMINISTRATOR / MARKETING</p>
<h1>Promotional Offers</h1>
<p>Schedule offers for one dish or several at once. Customers see promotional prices on the menu and at checkout; completed orders keep their original recorded prices. Active discounts also appear automatically in the welcome pop-up and featured promotions banner. You can optionally publish a custom announcement for a grouped offer.</p>

@if (TempData["PromotionSuccess"] is string success)
{
    <p class="success" role="status">@success</p>
}
@if (TempData["PromotionError"] is string error)
{
    <p class="error" role="alert">@error</p>
}

<div class="promotion-overview" aria-label="Promotion summary">
    <button type="button" class="card promotion-summary-button" data-promotion-summary-filter="active" aria-label="View @Model.ActiveCount active promotions">
        <span>Active promotions</span><strong>@Model.ActiveCount</strong><small>View current offers ↗</small>
    </button>
    <button type="button" class="card promotion-summary-button" data-promotion-summary-filter="scheduled" aria-label="View @Model.ScheduledCount scheduled promotions">
        <span>Scheduled promotions</span><strong>@Model.ScheduledCount</strong><small>View upcoming offers ↗</small>
    </button>
    <a class="card promotion-summary-button" asp-page="/Admin/MenuManagement" aria-label="Manage @Model.Dishes.Count menu dishes">
        <span>Total menu dishes</span><strong>@Model.Dishes.Count</strong><small>Manage menu dishes ↗</small>
    </a>
</div>

<section class="card" aria-labelledby="bulk-promotion-heading">
    <p class="eyebrow">BULK PROMOTION · MULTIPLE DISHES</p>
    <h2 id="bulk-promotion-heading">Create a group offer</h2>
    <p class="muted"><strong>One offer for several dishes.</strong> Select any dishes, choose a shared discount and date range, and optionally publish a customer announcement. This replaces existing offers on the selected dishes.</p>
    <form method="post" asp-page-handler="ApplyBulk">
        <fieldset>
            <legend>Select menu dishes</legend>
            <div class="promotion-bulk-groups">
                @foreach (var categoryGroup in Model.Dishes.GroupBy(d => d.Category).OrderBy(g => g.Key))
                {
                    <section class="promotion-bulk-category" aria-label="@categoryGroup.Key">
                        <h3>@categoryGroup.Key</h3>
                        <div class="promotion-bulk-list">
                            @foreach (var dish in categoryGroup.OrderBy(d => d.Name))
                            {
                                <label>
                                    <input type="checkbox" name="menuItemIds" value="@dish.MenuItemID" />
                                    <span>@dish.Name</span>
                                </label>
                            }
                        </div>
                    </section>
                }
            </div>
        </fieldset>
        <div class="promotion-bulk-fields">
            <div>
                <label for="bulk-discount">Discount (%)</label>
                <input id="bulk-discount" name="discountPercent" type="number" min="0.01" max="50" step="0.01" value="10" required />
            </div>
            <div>
                <label for="bulk-start">Start date</label>
                <input id="bulk-start" name="promotionStartDate" type="date" value="@Model.Today.ToString("yyyy-MM-dd")" required />
            </div>
            <div>
                <label for="bulk-end">End date (inclusive)</label>
                <input id="bulk-end" name="promotionEndDate" type="date" value="@Model.Today.AddDays(6).ToString("yyyy-MM-dd")" required />
            </div>
        </div>
        <div class="promotion-bulk-message">
            <label class="promotion-bulk-check">
                <input type="checkbox" name="publishAnnouncement" value="true" />
                Publish a custom promotional announcement (optional)
            </label>
            <div>
                <label for="bulk-title">Announcement title (optional)</label>
                <input id="bulk-title" type="text" name="announcementTitle" maxlength="120" placeholder="A limited-time offer from Céleste" />
            </div>
            <div>
                <label for="bulk-message">Announcement message (optional)</label>
                <textarea id="bulk-message" name="announcementMessage" rows="3" maxlength="1000" placeholder="Leave blank to generate a message using the selected dishes."></textarea>
            </div>
            <p class="promotion-automatic-display">✓ Active discounts appear automatically in the customer welcome pop-up and featured offers above dining spaces. Choose the checkbox to give a grouped offer your own title and message.</p>
            <p class="muted">The custom announcement is optional. Scheduled offers appear automatically when their campaign begins and disappear after their last day.</p>
        </div>
        <button type="submit">APPLY TO SELECTED DISHES</button>
    </form>
</section>

<section class="card" aria-labelledby="promotion-management-heading">
    <p class="eyebrow">INDIVIDUAL PROMOTION · ONE DISH</p>
    <h2 id="promotion-management-heading">Edit an individual offer</h2>
    <p class="muted"><strong>Fine-tune one dish at a time.</strong> Create, change, or remove its promotion without affecting other dishes. Discounts can be up to 50%, with inclusive dates in Malaysia time. An unavailable dish remains hidden until enabled in Menu Management.</p>

    @if (!Model.Dishes.Any())
    {
        <p>No dishes exist yet. Add dishes in Menu Management before creating a promotion.</p>
    }

    @{
        var preferredCategoryOrder = new[] { "Soups", "Appetizers", "Main Course", "Desserts", "Beverages" };
        var promotionGroups = Model.Dishes.GroupBy(item => item.Category)
            .OrderBy(group => {
                var position = Array.IndexOf(preferredCategoryOrder, group.Key);
                return position < 0 ? int.MaxValue : position;
            })
            .ThenBy(group => group.Key)
            .ToList();
    }
    @if (promotionGroups.Count > 0)
    {
        <div class="promotion-offer-toolbar">
        <nav class="menu-category-tabs promotion-category-tabs" aria-label="Filter individual offers by category">
            <button type="button" class="menu-category-tab is-active" data-promotion-category-tab="all" aria-pressed="true">
                All dishes <span>@Model.Dishes.Count</span>
            </button>
            @foreach (var categoryGroup in promotionGroups)
            {
                <button type="button" class="menu-category-tab" data-promotion-category-tab="@categoryGroup.Key" aria-pressed="false">
                    @categoryGroup.Key <span>@categoryGroup.Count()</span>
                </button>
            }
        </nav>
        <div class="promotion-status-picker">
            <label for="promotion-status-filter">Promotion status</label>
            <select id="promotion-status-filter" aria-label="Filter dishes by promotion status">
                <option value="all">All promotions</option>
                <option value="active">Current promotions</option>
                <option value="scheduled">Scheduled promotions</option>
                <option value="none">No promotions</option>
            </select>
        </div>
        </div>
    }
    <div class="promotion-category-list">
        @foreach (var categoryGroup in promotionGroups)
        {
            <section class="promotion-category-panel" data-promotion-category-panel="@categoryGroup.Key">
                <header class="promotion-category-heading">
                    <h3>@categoryGroup.Key</h3>
                    <span>@categoryGroup.Count() dish@(categoryGroup.Count() == 1 ? "" : "es")</span>
                </header>
                @foreach (var item in categoryGroup)
                {
                    var status = MenuPricing.CampaignStatus(item, Model.Today);
                    <article class="promotion-item" data-promotion-status="@status">
                        <div class="promotion-heading">
                            <div>
                                <h3>@item.Name</h3>
                                <p class="muted">@item.Category · Original price RM @item.Price.ToString("0.00")</p>
                                @if (item.DiscountPercent is > 0m && item.PromotionStartDate.HasValue && item.PromotionEndDate.HasValue)
                                {
                                    <p class="promotion-price-note">
                                        Offer price: <strong>RM @MenuPricing.DiscountedPrice(item).ToString("0.00")</strong>
                                        (@item.DiscountPercent.Value.ToString("0.##")% off)
                                    </p>
                                }
                            </div>
                            <div>
                                <span class="promotion-status @(status == "Active" ? "active" : status == "Scheduled" ? "scheduled" : "")">@status</span>
                                @if (!item.IsAvailable)
                                {
                                    <span class="badge">Dish unavailable</span>
                                }
                            </div>
                        </div>

                        <form method="post" asp-page-handler="Save">
                            <input type="hidden" name="menuItemId" value="@item.MenuItemID" />
                            <div class="promotion-fields">
                                <div>
                                    <label for="discount-@item.MenuItemID">Discount (%)</label>
                                    <input id="discount-@item.MenuItemID" name="discountPercent" type="number"
                                           min="0.01" max="50" step="0.01" required
                                           value="@(item.DiscountPercent?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? "10")" />
                                </div>
                                <div>
                                    <label for="promo-start-@item.MenuItemID">Start date</label>
                                    <input id="promo-start-@item.MenuItemID" name="promotionStartDate" type="date" required
                                           value="@(item.PromotionStartDate?.ToString("yyyy-MM-dd") ?? Model.Today.ToString("yyyy-MM-dd"))" />
                                </div>
                                <div>
                                    <label for="promo-end-@item.MenuItemID">End date</label>
                                    <input id="promo-end-@item.MenuItemID" name="promotionEndDate" type="date" required
                                           value="@(item.PromotionEndDate?.ToString("yyyy-MM-dd") ?? Model.Today.AddDays(6).ToString("yyyy-MM-dd"))" />
                                </div>
                                <button type="submit">SAVE OFFER</button>
                            </div>
                        </form>
                        @if (item.DiscountPercent.HasValue)
                        {
                            <div class="promotion-tools">
                                <form method="post" asp-page-handler="Stop"
                                      onsubmit="return confirm('Remove the promotional offer for this dish?');">
                                    <input type="hidden" name="menuItemId" value="@item.MenuItemID" />
                                    <button type="submit" class="secondary">REMOVE OFFER</button>
                                </form>
                            </div>
                        }
                    </article>
                }

            </section>
        }
    </div>
    <p class="promotion-filter-empty" id="promotion-filter-empty" role="status" hidden>No dishes match the selected filters.</p>
</section>

@section Scripts {
    <script>
        const promotionTabs = Array.from(document.querySelectorAll('[data-promotion-category-tab]'));
        const promotionPanels = Array.from(document.querySelectorAll('[data-promotion-category-panel]'));
        const promotionStatusSelect = document.getElementById('promotion-status-filter');
        const promotionEmpty = document.getElementById('promotion-filter-empty');
        const promotionHeading = document.getElementById('promotion-management-heading');
        let selectedCategory = 'all';

        function refreshPromotionFilters() {
            const status = promotionStatusSelect?.value || 'all';
            let visibleCount = 0;

            promotionPanels.forEach(panel => {
                const categoryMatches = selectedCategory === 'all' ||
                    panel.dataset.promotionCategoryPanel === selectedCategory;
                let matchingInPanel = 0;

                panel.querySelectorAll('[data-promotion-status]').forEach(item => {
                    const itemStatus = item.dataset.promotionStatus;
                    const statusMatches = status === 'all' ||
                        (status === 'active' && itemStatus === 'Active') ||
                        (status === 'scheduled' && itemStatus === 'Scheduled') ||
                        (status === 'none' && (itemStatus === 'No promotion' || itemStatus === 'Expired'));
                    item.hidden = !categoryMatches || !statusMatches;
                    if (categoryMatches && statusMatches) matchingInPanel++;
                });

                panel.hidden = !categoryMatches || matchingInPanel === 0;
                visibleCount += matchingInPanel;
            });

            if (promotionEmpty) promotionEmpty.hidden = visibleCount > 0;
            promotionTabs.forEach(tab => {
                const active = tab.dataset.promotionCategoryTab === selectedCategory;
                tab.classList.toggle('is-active', active);
                tab.setAttribute('aria-pressed', String(active));
            });
        }

        promotionTabs.forEach(tab => {
            tab.addEventListener('click', () => {
                selectedCategory = tab.dataset.promotionCategoryTab;
                refreshPromotionFilters();
            });
        });
        promotionStatusSelect?.addEventListener('change', refreshPromotionFilters);

        document.querySelectorAll('[data-promotion-summary-filter]').forEach(card => {
            card.addEventListener('click', () => {
                selectedCategory = 'all';
                const status = card.dataset.promotionSummaryFilter;
                if (promotionStatusSelect?.tomselect) {
                    promotionStatusSelect.tomselect.setValue(status);
                } else if (promotionStatusSelect) {
                    promotionStatusSelect.value = status;
                }
                refreshPromotionFilters();
                promotionHeading?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        });
        refreshPromotionFilters();
    </script>
}

@page
@model RROMS.Pages.Admin.ReportsModel

@{
	ViewData["Title"] = "Reservation Reports";
}

<p class="eyebrow">REPORTING & ANALYTICS</p>

<h1>Reservation Reports</h1>

<p>
	View reservation statistics and deposit information
	for a selected reporting period.
</p>



@{
    var quickToday = ReservationPolicy.Now.Date;
    var quickWeek = quickToday.AddDays(-(((int)quickToday.DayOfWeek + 6) % 7));
    var quickMonth = new DateTime(quickToday.Year, quickToday.Month, 1);
}
<div class="report-period-presets">
    <span>Quick periods:</span>
    <a asp-page="/Admin/Reports" asp-route-StartDate="@quickToday.ToString("yyyy-MM-dd")" asp-route-EndDate="@quickToday.ToString("yyyy-MM-dd")">Today</a>
    <a asp-page="/Admin/Reports" asp-route-StartDate="@quickWeek.ToString("yyyy-MM-dd")" asp-route-EndDate="@quickToday.ToString("yyyy-MM-dd")">This Week</a>
    <a asp-page="/Admin/Reports" asp-route-StartDate="@quickMonth.ToString("yyyy-MM-dd")" asp-route-EndDate="@quickToday.ToString("yyyy-MM-dd")">This Month</a>
</div>
<form method="get" class="report-period-form">

    <section class="card report-period-card">

        <h2>Select Reporting Period</h2>

		<div class="report-date-fields">

			<div class="report-date-field">
				<label asp-for="StartDate">Start Date</label>
				<input asp-for="StartDate" type="date" />
			</div>

			<div class="report-date-field">
				<label asp-for="EndDate">End Date</label>
				<input asp-for="EndDate" type="date" />
			</div>

		</div>

        <div asp-validation-summary="All"
             class="text-danger"></div>

        <div class="report-actions">

            <button type="submit"
                    class="report-action-button">
                Generate Report
            </button>

            <button type="submit"
                    name="handler"
                    value="Export"
                    class="secondary report-action-button">
                Export Report (CSV)
            </button>

        </div>

    </section>

</form>

@if (Model.Summary is { } report)
{
	// Prepare data for the status chart
	var statuses = new[]
	{
		new { Label = "Pending", Count = report.PendingReservations },
		new { Label = "Confirmed", Count = report.ConfirmedReservations },
		new { Label = "Seated", Count = report.SeatedReservations },
		new { Label = "Completed", Count = report.CompletedReservations },
		new { Label = "Cancelled", Count = report.CancelledReservations },
		new { Label = "No-show", Count = report.NoShowReservations },
		new { Label = "Expired", Count = report.ExpiredReservations }
	};


	<p>
		Reporting period:
		@report.StartDate.ToString("dd MMM yyyy")
		to
		@report.EndDate.ToString("dd MMM yyyy")
	</p>
	
<section class="staff-stats">

    <article class="card">
        <a class="text-reset text-decoration-none"
           asp-page="/Admin/ReportReservations"
           asp-route-StartDate="@report.StartDate.ToString("yyyy-MM-dd")"
           asp-route-EndDate="@report.EndDate.ToString("yyyy-MM-dd")">
            <small>TOTAL RESERVATIONS</small>
            <h2>@report.TotalReservations</h2>
            <p>View all reservations</p>
        </a>
    </article>

    <article class="card">
        <a class="text-reset text-decoration-none"
           asp-page="/Admin/ReportReservations"
           asp-route-StartDate="@report.StartDate.ToString("yyyy-MM-dd")"
           asp-route-EndDate="@report.EndDate.ToString("yyyy-MM-dd")"
           asp-route-Status="Confirmed">
            <small>CONFIRMED</small>
            <h2>@report.ConfirmedReservations</h2>
            <p>View confirmed reservations</p>
        </a>
    </article>

    <article class="card">
        <a class="text-reset text-decoration-none"
           asp-page="/Admin/ReportReservations"
           asp-route-StartDate="@report.StartDate.ToString("yyyy-MM-dd")"
           asp-route-EndDate="@report.EndDate.ToString("yyyy-MM-dd")"
           asp-route-Status="Seated">
            <small>SEATED / CHECKED IN</small>
            <h2>@report.SeatedReservations</h2>
            <p>View checked-in reservations</p>
        </a>
    </article>

    <article class="card">
        <a class="text-reset text-decoration-none"
           asp-page="/Admin/ReportReservations"
           asp-route-StartDate="@report.StartDate.ToString("yyyy-MM-dd")"
           asp-route-EndDate="@report.EndDate.ToString("yyyy-MM-dd")"
           asp-route-Status="Completed">
            <small>COMPLETED</small>
            <h2>@report.CompletedReservations</h2>
            <p>View completed reservations</p>
        </a>
    </article>

</section>

<section class="staff-stats">

    <article class="card">
        <a class="text-reset text-decoration-none"
           asp-page="/Admin/ReportReservations"
           asp-route-StartDate="@report.StartDate.ToString("yyyy-MM-dd")"
           asp-route-EndDate="@report.EndDate.ToString("yyyy-MM-dd")"
           asp-route-Status="Cancelled">
            <small>CANCELLED</small>
            <h2>@report.CancelledReservations</h2>
            <p>View cancelled reservations</p>
        </a>
    </article>

    <article class="card">
        <a class="text-reset text-decoration-none"
           asp-page="/Admin/ReportReservations"
           asp-route-StartDate="@report.StartDate.ToString("yyyy-MM-dd")"
           asp-route-EndDate="@report.EndDate.ToString("yyyy-MM-dd")"
           asp-route-Status="No-show">
            <small>NO-SHOWS</small>
            <h2>@report.NoShowReservations</h2>
            <p>View no-show reservations</p>
        </a>
    </article>

    <article class="card">
        <small>PAID DEPOSITS</small>
        <h2>RM @report.PaidDeposits.ToString("N2")</h2>
    </article>

    <article class="card">
        <small>FORFEITED DEPOSITS</small>
        <h2>RM @report.ForfeitedDeposits.ToString("N2")</h2>
    </article>

</section>


	<!-- Reservation status chart -->
	<section class="card report-chart">
		<h2>Reservation Status Breakdown</h2>

		<p>
			Current reservation status distribution
			for the selected period.
		</p>

		@if (report.TotalReservations == 0)
		{
			<p>No reservations found for this period.</p>
		}
		else
		{
			@foreach (var status in statuses)
			{
				int percentage = (int)Math.Round(
					status.Count * 100.0
					/ report.TotalReservations);

				<div class="report-status-row">
					
					<div class="report-status-label">

						<a class="text-reset text-decoration-none"
						   asp-page="/Admin/ReportReservations"
						   asp-route-StartDate="@report.StartDate.ToString("yyyy-MM-dd")"
						   asp-route-EndDate="@report.EndDate.ToString("yyyy-MM-dd")"
						   asp-route-Status="@status.Label">

							<strong>@status.Label</strong>

							<span>
								@status.Count (@percentage%)
							</span>

						</a>

					</div>


					<div class="report-bar-track"
						role="progressbar"
						aria-label="@status.Label"
						aria-valuemin="0"
						aria-valuemax="@report.TotalReservations"
						aria-valuenow="@status.Count">
						
						<div class="report-bar-fill"
							style="width: @(percentage)%">
						</div>
					</div>
				</div>
			}
		}
	</section>

    <!-- Responsive reservation trend line, with exact numbers in an expandable table. -->
    <section class="card report-chart reservation-line-panel">
        <h2>Reservation Trend</h2>
        <p class="muted">
            Reservations by scheduled dining date.
            The chart groups by @Model.TrendGranularity for this reporting period.
            Hover or focus on a point to see its count.
        </p>
        @if (Model.TrendPoints.Count == 0 || Model.TrendPoints.All(p => p.Count == 0))
        {
            <p class="empty-state">No reservations were scheduled during this period.</p>
        }
        else
        {
            var maxCount = Model.TrendPoints.Max(p => p.Count);
            string Coord(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
            var plotted = Model.TrendPoints.Select((point, index) => new
            {
                Point = point,
                X = Coord(Model.TrendPoints.Count == 1 ? 498d : 60d + index * 875d / (Model.TrendPoints.Count - 1)),
                Y = Coord(245d - point.Count * 225d / Math.Max(1, maxCount))
            }).ToList();
            var linePoints = string.Join(" ", plotted.Select(point => point.X + "," + point.Y));
            var step = Math.Max(1, (int)Math.Ceiling(plotted.Count / 7.0));
            <div class="reservation-line-chart">
                <svg viewBox="0 0 975 310" role="img" aria-labelledby="reservation-trend-title reservation-trend-description">
                    <title id="reservation-trend-title">Reservation trend over the selected reporting period</title>
                    <desc id="reservation-trend-description">
                        A line representing @Model.TrendPoints.Sum(p => p.Count) scheduled reservations grouped by @Model.TrendGranularity.
                        Exact counts are available in the table below.
                    </desc>
                    @for (var tick = 0; tick <= 4; tick++)
                    {
                        var y = Coord(245d - tick * 225d / 4d);
                        var count = (int)Math.Round(maxCount * tick / 4d);
                        <line class="reservation-chart-gridline" x1="60" y1="@y" x2="935" y2="@y"></line>
                        @Html.Raw($"<text class=\"reservation-chart-axis\" x=\"48\" y=\"{Coord(245d - tick * 225d / 4d + 4d)}\" text-anchor=\"end\">{count}</text>")
                    }
                    <polyline class="reservation-chart-line" points="@linePoints"></polyline>
                    @for (var index = 0; index < plotted.Count; index++)
                    {
                        var point = plotted[index];
                        <circle class="reservation-chart-point" cx="@point.X" cy="@point.Y" r="5" tabindex="0">
                            <title>@point.Point.Count reservations, @point.Point.StartDate.ToString("dd MMM yyyy") to @point.Point.EndDate.ToString("dd MMM yyyy")</title>
                        </circle>
                        @if (index % step == 0 || index == plotted.Count - 1)
                        {
                            @Html.Raw($"<text class=\"reservation-chart-axis reservation-chart-date\" x=\"{point.X}\" y=\"279\" text-anchor=\"middle\">{point.Point.StartDate.ToString(Model.TrendGranularity == "month" ? "MMM yy" : "dd MMM")}</text>")
                        }
                    }
                </svg>
            </div>
            <details class="reservation-trend-data">
                <summary>View exact values and open reservations</summary>
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Scheduled date / period</th><th>Reservations</th></tr></thead>
                        <tbody>
                            @foreach (var point in Model.TrendPoints)
                            {
                                <tr>
                                    <td>
                                        <a asp-page="/Admin/ReportReservations"
                                           asp-route-StartDate="@point.StartDate.ToString("yyyy-MM-dd")"
                                           asp-route-EndDate="@point.EndDate.ToString("yyyy-MM-dd")">
                                            @point.StartDate.ToString("dd MMM yyyy")
                                            @if (point.EndDate != point.StartDate) { <span>– @point.EndDate.ToString("dd MMM yyyy")</span> }
                                        </a>
                                    </td>
                                    <td>@point.Count</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        }
    </section>

	<!-- Daily deposit collection chart -->
	<section class="card report-chart">
		<h2>Daily Deposit Collections</h2>

		<p>
			Successful reservation deposits grouped by
			the date the payment was recorded.
		</p>

		@{
			decimal totalCollected = Model.DailyDeposits
				.Sum(d => d.TotalAmount);

			int totalPayments = Model.DailyDeposits
				.Sum(d => d.PaymentCount);

			decimal maxDailyAmount = Model.DailyDeposits.Count == 0
				? 0m
				: Model.DailyDeposits.Max(d => d.TotalAmount);
		}

		<div class="staff-stats">
			<article class="card">
				<small>DEPOSITS COLLECTED</small>
				<h2>RM @totalCollected.ToString("N2")</h2>
			</article>

			<article class="card">
				<small>SUCCESSFUL TRANSACTIONS</small>
				<h2>@totalPayments</h2>
			</article>
		</div>

		@if (maxDailyAmount == 0m)
		{
			<p>
				No successful deposit payments were recorded
				during this period.
			</p>
		}
		else
		{
			<div class="report-trend-scroll">
				@foreach (var day in Model.DailyDeposits)
				{
					int percentage = (int)Math.Round(
						day.TotalAmount * 100m / maxDailyAmount);

					string dateLabel = day.Date.ToString("dd MMM yyyy");

					<div class="report-status-row">
						<div class="report-status-label">
							<strong>@dateLabel</strong>
							<span>
								RM @day.TotalAmount.ToString("N2")
								(@day.PaymentCount paid)
							</span>
						</div>

						<div class="report-bar-track"
							 role="progressbar"
							 aria-label="@dateLabel deposit collections"
							 aria-valuemin="0"
							 aria-valuemax="@maxDailyAmount"
							 aria-valuenow="@day.TotalAmount">

							<div class="report-bar-fill"
								 style="width: @(percentage)%">
							</div>
						</div>
					</div>
				}
			</div>
		}
	</section>


	<p class="notice">
		Reservation counts are based on scheduled dining dates,
		including reservations that were subsequently cancelled or expired.

		Deposit amounts are associated with reservations
		scheduled during the selected period.
		Forfeited deposits are already included in paid deposits. 

		Daily deposit collections are grouped by payment date,
		which may differ from the scheduled reservation date.
	</p>
@if (Model.Insights is { } insights)
{
    <section class="staff-stats">
        <article class="card"><small>ACTIVE DINING CUSTOMERS</small><h2>@insights.ActiveCustomers</h2></article>
        <article class="card"><small>FIRST-TIME CUSTOMERS</small><h2>@insights.NewCustomers</h2></article>
        <article class="card"><small>RETURNING CUSTOMERS</small><h2>@insights.ReturningCustomers</h2></article>
        <article class="card"><small>AVERAGE PARTY SIZE</small><h2>@insights.AveragePartySize.ToString("N1")</h2></article>
    </section>

    <section class="card">
        <h2>Customer Activity &amp; Ordering</h2>
        <p>Average orders per reservation: <strong>@insights.OrdersPerReservation.ToString("N2")</strong></p>
        <p class="muted">
            Active customers have confirmed, seated or completed bookings within the selected dates.
            Returning customers have two or more valid bookings through the end of the period.
        </p>
        <a asp-page="/Admin/MenuPerformance"
           asp-route-StartDate="@Model.StartDate.ToString("yyyy-MM-dd")"
           asp-route-EndDate="@Model.EndDate.ToString("yyyy-MM-dd")">View menu performance separately →</a>
    </section>
}

}
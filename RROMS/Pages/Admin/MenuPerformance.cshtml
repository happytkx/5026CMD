@page
@model RROMS.Pages.Admin.MenuPerformanceModel
@{
    ViewData["Title"] = "Menu Performance";
    var today = ReservationPolicy.Now.Date;
    var thisWeek = today.AddDays(-(((int)today.DayOfWeek + 6) % 7));
    var thisMonth = new DateTime(today.Year, today.Month, 1);
}

<p class="eyebrow">REPORTING &amp; ANALYTICS</p>
<h1>Menu Performance</h1>
<p>See how dishes perform within one menu category at a time, including dishes with no orders.</p>

<div class="report-period-presets">
    <span>Quick periods:</span>
    <a asp-page="/Admin/MenuPerformance" asp-route-StartDate="@today.ToString("yyyy-MM-dd")" asp-route-EndDate="@today.ToString("yyyy-MM-dd")" asp-route-Category="@Model.Category" asp-route-SortBy="@Model.SortBy">Today</a>
    <a asp-page="/Admin/MenuPerformance" asp-route-StartDate="@thisWeek.ToString("yyyy-MM-dd")" asp-route-EndDate="@today.ToString("yyyy-MM-dd")" asp-route-Category="@Model.Category" asp-route-SortBy="@Model.SortBy">This Week</a>
    <a asp-page="/Admin/MenuPerformance" asp-route-StartDate="@thisMonth.ToString("yyyy-MM-dd")" asp-route-EndDate="@today.ToString("yyyy-MM-dd")" asp-route-Category="@Model.Category" asp-route-SortBy="@Model.SortBy">This Month</a>
</div>

<form method="get" class="card menu-performance-filters">
    <div class="menu-performance-filter-grid">
        <div>
            <label asp-for="Category">Menu category</label>
            <select asp-for="Category" class="menu-performance-select">
                @foreach (var category in Model.Categories)
                {
                    <option value="@category">@category</option>
                }
            </select>
        </div>
        <div>
            <label asp-for="SortBy">Order by</label>
            <select asp-for="SortBy" class="menu-performance-select">
                <option value="MostOrdered">Most ordered to least ordered</option>
                <option value="LeastOrdered">Least ordered to most ordered</option>
            </select>
        </div>
        <div>
            <label asp-for="StartDate">Start date</label>
            <input asp-for="StartDate" type="date" />
        </div>
        <div>
            <label asp-for="EndDate">End date</label>
            <input asp-for="EndDate" type="date" />
        </div>
    </div>
    <div asp-validation-summary="All" class="text-danger menu-performance-validation"></div>
    <div class="report-actions">
        <button type="submit" class="report-action-button">Apply filters</button>
        <button type="submit" name="handler" value="Export" class="secondary report-action-button">Export CSV</button>
    </div>
</form>

@if (Model.HasValidPeriod && Model.Category is not null)
{
    <p class="menu-performance-selection">
        Showing <strong>@Model.Category</strong> from @Model.StartDate.ToString("dd MMM yyyy")
        to @Model.EndDate.ToString("dd MMM yyyy").
        Choose another category above to compare its dishes.
    </p>

    <section class="staff-stats">
        <article class="card"><small>DISHES IN CATEGORY</small><h2>@Model.Dishes.Count</h2></article>
        <article class="card"><small>UNITS ORDERED</small><h2>@Model.TotalQuantity</h2></article>
        <article class="card"><small>SALES BEFORE TAX</small><h2>RM @Model.TotalSales.ToString("N2")</h2></article>
        <article class="card"><small>DISHES WITH ZERO ORDERS</small><h2>@Model.NeverOrdered</h2></article>
    </section>

    <section class="card menu-performance-panel">
        <h2>@Model.Category: Dish Ordering</h2>
        <p class="muted">
            Ordered quantities, based on order placement dates.
            Cancelled dishes and cancelled orders are excluded.
            Zero-order dishes remain in the comparison.
        </p>
        @if (Model.Dishes.Count == 0)
        {
            <p class="empty-state">There are no dishes assigned to this category yet.</p>
        }
        else
        {
            <div class="menu-performance-bars" role="list" aria-label="Menu items ordered in @Model.Category">
                @foreach (var dish in Model.Dishes)
                {
                    var percentage = Model.MaximumQuantity == 0 ? 0 : (int)Math.Round(dish.Quantity * 100.0 / Model.MaximumQuantity);
                    <div class="menu-performance-bar-row" role="listitem">
                        <div class="menu-performance-bar-label">
                            <strong>@dish.Name</strong>
                            <span>@dish.Quantity ordered · RM @dish.Sales.ToString("N2")</span>
                        </div>
                        <div class="menu-performance-bar-track" role="progressbar"
                             aria-label="@dish.Name" aria-valuemin="0" aria-valuemax="@Math.Max(1, Model.MaximumQuantity)" aria-valuenow="@dish.Quantity">
                            <div class="menu-performance-bar-fill" style="width: @(percentage)%"></div>
                        </div>
                    </div>
                }
            </div>
            <details class="menu-performance-data">
                <summary>View detailed data table</summary>
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Dish</th><th>Qty</th><th>Sales (RM, before tax)</th></tr></thead>
                        <tbody>
                            @foreach (var dish in Model.Dishes)
                            {
                                <tr><td>@dish.Name</td><td>@dish.Quantity</td><td>RM @dish.Sales.ToString("N2")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        }
        <p class="muted">Dish categories reflect the current menu. Historical sales use the original order-line prices.</p>
    </section>
}

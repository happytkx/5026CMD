@page
@model RROMS.Pages.Admin.OperatingHoursModel

@{
    ViewData["Title"] = "Operating Hours";
}

<p class="eyebrow">RESTAURANT CONFIGURATION</p>

<h1>Operating Hours</h1>

<p>
    Manage Céleste's restaurant opening and closing times.
    These hours are used when customers make reservations.
</p>

@if (TempData["Success"] != null)
{
    <p class="success" role="status">
        @TempData["Success"]
    </p>
}

@if (TempData["Error"] != null)
{
    <p class="notice" role="alert">
        @TempData["Error"]
    </p>
}

<section class="card">
    <h2>Current Operating Hours</h2>

    @if (Model.SettingExists)
    {
        <p>
            <strong>Opening Time:</strong>
            @Model.CurrentOpeningTime.ToString(@"hh\:mm")
        </p>

        <p>
            <strong>Closing Time:</strong>
            @Model.CurrentClosingTime.ToString(@"hh\:mm")
        </p>
    }
    else
    {
        <p class="notice">
            Operating hours have not been configured.
            Please enter the restaurant's opening and closing times.
        </p>
    }
</section>

<section class="card">
    <p class="eyebrow">ADMINISTRATOR SETTINGS</p>

    <h2>Update Operating Hours</h2>

    <p class="muted">
        Enter the restaurant's daily operating hours
        using Malaysia time.
    </p>

    <form method="post">
        <div>
            <label asp-for="OpeningTime">Opening Time</label>

            <input asp-for="OpeningTime"
                   type="time"
                   step="1800"
                   required />

            <span asp-validation-for="OpeningTime"
                  class="text-danger"></span>
        </div>

        <div>
            <label asp-for="ClosingTime">Closing Time</label>

            <input asp-for="ClosingTime"
                   type="time"
                   step="1800"
                   required />

            <span asp-validation-for="ClosingTime"
                  class="text-danger"></span>
        </div>

        <p class="muted">
            Closing time must be later than opening time.
            Reservations must finish before the restaurant closes.
        </p>

        <button type="submit">
            SAVE OPERATING HOURS
        </button>
    </form>
</section>

<p class="notice">
    Changes to operating hours affect future reservation availability.
    Existing reservations are not automatically cancelled or modified.
</p>

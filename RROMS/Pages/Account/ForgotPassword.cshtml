@page
@model RROMS.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
    var internalAccount = Model.AccountType == "Administrator";
    var signInPage = internalAccount ? "StaffLogin" : "Login";
}
<section class="account-compact card">
    <p class="eyebrow">@(internalAccount ? "CÉLESTE / ADMINISTRATOR ACCESS" : "YOUR CÉLESTE ACCOUNT")</p><h1>Forgot your password?</h1>
    <p>Enter your account email and we will help you choose a new password.</p>
    @if (Model.Requested)
    {
        <div class="success" role="status">If this email belongs to an @(internalAccount ? "active administrator" : "verified customer") account, a password reset link has been requested. Check your inbox and spam folder. The link expires in 30 minutes. Allow a minute before requesting another; contact the restaurant if no email arrives.</div>
    }
    <form method="post" class="account-form">
        <input type="hidden" asp-for="AccountType" />
        <div asp-validation-summary="All" class="error" role="alert"></div>
        <label asp-for="Email">Email address</label><input asp-for="Email" type="email" autocomplete="email" required maxlength="100" />
        <button type="submit">Send reset link</button>
    </form>
    <p>
        <a asp-page="@signInPage">Back to sign in</a>
        @if (!internalAccount)
        {
            <text> · <a asp-page="VerifyEmail">Verify your email</a></text>
        }
    </p>
</section>

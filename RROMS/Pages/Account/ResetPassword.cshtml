@page
@model RROMS.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
    var signInPage = Model.AccountType == "Administrator" ? "StaffLogin" : "Login";
}
<section class="account-compact card">
    <p class="eyebrow">@(Model.AccountType == "Administrator" ? "CÉLESTE / ADMINISTRATOR ACCESS" : "YOUR CÉLESTE ACCOUNT")</p>
    @if (Model.LinkValid)
    {
        <h1>Choose a new password</h1><p>Use a unique password with at least 10 characters.</p>
        <form method="post" class="account-form">
            <input type="hidden" asp-for="AccountType" /><input type="hidden" asp-for="Id" /><input type="hidden" asp-for="Token" />
            <div asp-validation-summary="All" class="error" role="alert"></div>
            <label asp-for="Password"></label><input asp-for="Password" type="password" autocomplete="new-password" required minlength="10" maxlength="128" />
            <label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required maxlength="128" />
            <button type="submit">Reset password</button>
        </form>
    }
    else
    {
        <h1>This reset link is unavailable</h1><p>The link may have expired, already been used or been replaced by a newer link.</p>
        <a class="button" asp-page="ForgotPassword" asp-route-AccountType="@Model.AccountType">Request a new link</a>
    }
    <p><a asp-page="@signInPage">Back to sign in</a></p>
</section>


@page
@* Customer-only sign-in; restaurant personnel use the separate StaffLogin page. *@
@model RROMS.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Customer sign in";
}

<section class="account-heading">
    <p class="eyebrow">YOUR CÉLESTE ACCOUNT</p>
    <h1>Customer Sign In</h1>

    <p>
        Welcome back to Céleste. Sign in to manage your
        reservations and dining experience.
    </p>

    <p>
        <a asp-page="ForgotPassword">Forgot your password?</a>
    </p>
</section>

<section class="card auth-card">
    <form method="post">
        <input asp-for="ReturnUrl" type="hidden" />

        <div class="error" asp-validation-summary="All"></div>

        <div>
            <label asp-for="Email">Email address</label>
            <input asp-for="Email"
                   type="email"
                   maxlength="100"
                   autocomplete="username"
                   required />
        </div>

        <div>
            <label asp-for="Password">Password</label>
            <input asp-for="Password"
                   type="password"
                   autocomplete="current-password"
                   required />
        </div>

        <div>
            <label class="check">
                <input asp-for="RememberMe" />
                Keep me signed in on this device
            </label>
        </div>

        <button type="submit" class="wide-button">
            Sign in
        </button>
    </form>

    <div class="auth-login-footer">
        <p class="muted">
            New to Céleste?
            <a asp-page="Register"
               asp-route-ReturnUrl="@Model.ReturnUrl">
                Create a customer account
            </a>
        </p>

        <p class="muted auth-switch-link">
            <a asp-page="StaffLogin">Staff / Admin Login &rarr;</a>
        </p>
    </div>
</section>

@page "{id:int?}"
@model RROMS.Pages.MyBillModel
@{
    ViewData["Title"] = "My bill";
}
<section class="account-heading">
    <p class="eyebrow">YOUR CÉLESTE DINING EXPERIENCE</p>
    <h1>My Bill</h1>
    <p>Review your spending while dining and access your completed payment records.</p>
</section>

@if (Model.MyReservations.Count == 0)
{
    <section class="card empty-state">
        <p>You do not have any reservations yet.</p>
        <a class="button" asp-page="/Reservations/Create">Make a reservation</a>
    </section>
}
else if (Model.Booking is { } booking)
{
    <form method="get" class="card mybill-selector">
        <label for="id">Reservation</label>
        <select id="id" name="id" onchange="this.form.submit()">
            @foreach (var reservation in Model.MyReservations)
            {
                <option value="@reservation.ReservationID"
                        selected="@(reservation.ReservationID == booking.ReservationID)">
                    @reservation.BookingReference · @reservation.ReservationDate.ToString("dd MMM yyyy")
                    (@reservation.ReservationStatus)
                </option>
            }
        </select>
        <button type="submit" class="secondary">View Bill</button>
    </form>

    <section class="card celeste-customer-bill">
        <div class="celeste-bill-heading">
            <div>
                <p class="eyebrow">CÉLESTE FINE DINING</p>
                <h2>@(Model.IsPaid ? "Paid Final Bill" : "Live Running Bill")</h2>
                <p class="muted">Reservation @booking.BookingReference · @booking.PartySize guests</p>
            </div>
            <span class="celeste-bill-status @(Model.IsPaid ? "celeste-bill-status-paid" : "celeste-bill-status-draft")">
                @(Model.IsPaid ? "Paid" : "Estimate")
            </span>
        </div>

        @if (!Model.IsPaid)
        {
            <p class="notice">
                This is a running estimate based on orders already placed.
                It updates as new orders are recorded. Staff will verify your final bill before collecting payment.
            </p>
        }

        <div class="celeste-bill-grid">
            <div>
                <h3>Ordered Dishes</h3>
                @if (Model.Orders.Count == 0)
                {
                    <p>No active dining orders have been placed for this reservation.</p>
                }
                else
                {
                    <div class="table-wrap celeste-bill-lines">
                        <table>
                            <thead>
                                <tr><th>Dish</th><th>Qty</th><th>Unit Price</th><th>Line Total</th></tr>
                            </thead>
                            <tbody>
                            @foreach (var order in Model.Orders)
                            {
                                <tr class="celeste-bill-order-row">
                                    <td colspan="4">Order @order.Reference <span class="celeste-bill-order-state">@order.Status</span></td>
                                </tr>
                                @foreach (var line in order.Lines.OrderBy(l => l.OrderLineID))
                                {
                                    <tr>
                                        <td>@line.ItemName</td>
                                        <td>@line.Quantity</td>
                                        <td>RM @line.UnitPrice.ToString("N2")</td>
                                        <td>RM @line.LineTotal.ToString("N2")</td>
                                    </tr>
                                }
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <aside class="celeste-bill-summary">
                <h3>Bill Summary</h3>
                <dl>
                    <div><dt>Food &amp; Beverage Subtotal</dt><dd>RM @Model.FoodSubtotal.ToString("N2")</dd></div>
                    <div><dt>Tax (6%)</dt><dd>RM @Model.TaxAmount.ToString("N2")</dd></div>
                    <div class="celeste-bill-grand"><dt>Grand Total</dt><dd>RM @Model.GrandTotal.ToString("N2")</dd></div>
                    <div><dt>Minimum Spending</dt><dd>RM @booking.MinimumSpend.ToString("N2")</dd></div>
                    <div><dt>Paid Deposit Applied</dt><dd>− RM @Model.DepositApplied.ToString("N2")</dd></div>
                    @if (Model.IsPaid)
                    {
                        <div><dt>Final Payment Received</dt><dd>− RM @(Model.Payments.Where(p => p.PaymentType == "DiningBill").Sum(p => p.Amount).ToString("N2"))</dd></div>
                    }
                    <div class="celeste-bill-balance">
                        <dt>@(Model.IsPaid ? "Outstanding Balance" : "Estimated Balance")</dt>
                        <dd>RM @Model.Outstanding.ToString("N2")</dd>
                    </div>
                </dl>
                @if (!Model.IsPaid && Model.Shortfall > 0m)
                {
                    <p class="celeste-bill-alert">
                        RM @Model.Shortfall.ToString("N2") more in food and beverage orders is needed to meet the minimum spending requirement (before tax).
                    </p>
                }
                else if (Model.IsPaid)
                {
                    <p class="celeste-bill-paid-note">Your final bill is paid. Thank you for dining with us.</p>
                }
                else
                {
                    <p class="celeste-bill-paid-note">Minimum spending requirement met.</p>
                }
            </aside>
        </div>
    </section>

    <section class="card">
        <h2>Payment History &amp; Receipts</h2>
        @if (Model.Payments.Count == 0)
        {
            <p>No successful payment transactions are recorded for this reservation yet.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Date</th><th>Payment</th><th>Method</th><th>Amount</th><th>Receipt</th></tr></thead>
                    <tbody>
                    @foreach (var payment in Model.Payments)
                    {
                        <tr>
                            <td>@payment.PaymentDate.ToString("dd MMM yyyy, h:mm tt")</td>
                            <td>@(payment.PaymentType == "Deposit" ? "Reservation Deposit" : "Final Dining Payment")</td>
                            <td>@payment.PaymentMethod</td>
                            <td>RM @payment.Amount.ToString("N2")</td>
                            <td>
                                <a asp-page="/Staff/PaymentReceipt" asp-route-id="@payment.PaymentID">View / Print Receipt</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
}
@section Scripts {
    @if (Model.Booking is { ReservationStatus: "Seated" } && !Model.IsPaid)
    {
        <script>setTimeout(function () { if (!document.hidden) window.location.reload(); }, 30000);</script>
    }
}

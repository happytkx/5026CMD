@page
@* A reservation is one dining session; expand it to manage each kitchen round and individual dishes. *@
@model RROMS.Pages.Staff.OrdersModel
@{
    ViewData["Title"] = "Dining orders";
    var sessions = Model.Orders.GroupBy(o => o.ReservationID)
        .OrderByDescending(g => g.Max(o => o.CreatedAt)).ToList();
}
<p class="eyebrow">RESTAURANT OPERATIONS</p>
<h1>Dining Orders</h1>
<p>Every reservation appears once. Open View Details to follow the dishes and manage kitchen progress. Select and update multiple dishes across ordering rounds in one action. Staff can cancel an unserved dish; cancelled dishes are excluded from billing.</p>
<p><a class="button secondary" asp-page="/Staff/Billing">Go to Billing &amp; Checkout</a></p>
@if (TempData["Success"] is string ok)
{
    <p class="success">@ok</p>
}
@if (TempData["Error"] is string err)
{
    <p class="error">@err</p>
}
@if (Model.OrderLoadTimedOut)
{
    <section class="card notice" role="alert">
        <h2>Dining orders are temporarily unavailable</h2>
        <p>The database took too long to respond. No orders were changed. Please try again in a moment.</p>
        <a class="button secondary" asp-page="/Staff/Orders">Retry loading orders</a>
    </section>
}
else
{
<div class="staff-stats">
    <section class="card">
        <small>IN PROGRESS</small>
        <h2>@Model.Orders.Where(o => o.Lines.Any(l => !l.IsCancelled && (l.KitchenStatus is "Received" or "Preparing" or "Ready to Serve"))).Select(o => o.ReservationID).Distinct().Count()</h2>
        <p>Reservations with unserved dishes</p>
    </section>
    <section class="card">
        <small>RECEIVED</small>
        <h2>@Model.Orders.Where(o => o.Lines.Any(l => !l.IsCancelled && l.KitchenStatus == "Received")).Select(o => o.ReservationID).Distinct().Count()</h2>
        <p>Reservations with new dishes</p>
    </section>
    <section class="card">
        <small>READY TO SERVE</small>
        <h2>@Model.Orders.Where(o => o.Lines.Any(l => !l.IsCancelled && l.KitchenStatus == "Ready to Serve")).Select(o => o.ReservationID).Distinct().Count()</h2>
        <p>Reservations ready for service</p>
    </section>
    <section class="card">
        <small>DINING SESSIONS</small>
        <h2>@sessions.Count</h2>
        <p>Recently active reservations</p>
    </section>
</div>

<section class="card staff-dining-search-panel" aria-label="Search dining orders">
    <form method="get" class="staff-dining-search">
        <label asp-for="Search">Find a dining session</label>
        <div class="staff-dining-search-controls">
            <input asp-for="Search" type="search" maxlength="100" autocomplete="off"
                   placeholder="Search table ID, customer name or reservation code"
                   aria-label="Search by table, customer name or reservation code" />
            <button type="submit">Search</button>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <a class="button secondary" asp-page="/Staff/Orders">Clear</a>
            }
        </div>
    </form>
    @if (!string.IsNullOrWhiteSpace(Model.Search))
    {
        <p class="staff-dining-search-count" role="status">
            Showing @sessions.Count dining session@(sessions.Count == 1 ? "" : "s") matching <strong>@Model.Search</strong>.
        </p>
    }
</section>

}

@if (!Model.OrderLoadTimedOut && !sessions.Any())
{
    <section class="card empty-state">
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <p>No dining sessions match <strong>@Model.Search</strong>. Try a table ID, customer name or reservation code.</p>
            <a class="button secondary" asp-page="/Staff/Orders">Show all dining orders</a>
        }
        else
        {
            <p>No dining orders yet.</p>
        }
    </section>
}
else if (!Model.OrderLoadTimedOut)
{
    <div class="staff-dining-sessions">
        @foreach (var session in sessions)
        {
            var rounds = session.OrderBy(o => o.CreatedAt).ThenBy(o => o.OrderID).ToList();
            var booking = rounds[0].Reservation;
            var customer = rounds[0].Customer;
            var isPaid = Model.PaidReservationIds.Contains(booking.ReservationID);

            <section class="card staff-dining-session">
                <div class="staff-session-header">
                    <div>
                        <p class="reference">RESERVATION · @booking.BookingReference</p>
                        <h2>Table @booking.TableID · @customer.CustomerName</h2>
                        <p class="staff-session-meta">
                            @DiningOrderPresentation.ActiveItemCount(rounds) items ·
                            @rounds.Count ordering round@(rounds.Count == 1 ? "" : "s")
                            · @booking.ReservationDate.ToString("dd MMM yyyy")
                        </p>
                    </div>
                    <div class="staff-session-summary">
                        <span class="badge">@DiningOrderPresentation.Status(rounds)</span>
                        <strong>RM @DiningOrderPresentation.Total(rounds).ToString("N2")</strong>
                        <a asp-page="/Staff/BillDetails" asp-route-id="@booking.ReservationID">View Bill</a>
                    </div>
                </div>

                <details class="staff-session-details" open="@(Model.Expanded == booking.ReservationID)">
                    <summary>
                        <strong>View Details</strong>
                        <span>Items, kitchen status and dish cancellation</span>
                    </summary>
                    <div class="staff-session-details-body">
                        @{
                            var sessionEditableLines = rounds
                                .SelectMany(order => order.Lines)
                                .Where(line => !line.IsCancelled && OrdersModel.NextDishStatus(line.KitchenStatus) != null)
                                .OrderBy(line => line.OrderLineID).ToList();
                        }
                        @if (sessionEditableLines.Count > 0 && booking.ReservationStatus == "Seated" && !isPaid)
                        {
                            <details class="dish-status-editor session-bulk-editor">
                                <summary>Bulk update dish statuses (@sessionEditableLines.Count available)</summary>
                                <form method="post" asp-page-handler="UpdateSessionDishes" class="dish-status-form">
                                    <input type="hidden" name="reservationId" value="@booking.ReservationID" />
                                    <input type="hidden" name="Search" value="@Model.Search" />
                                    <div class="dish-status-instruction">
                                        <strong>Update multiple ordered dishes at once</strong>
                                        <p>Tick any dishes from this dining session. Each selected dish automatically advances one step, even when the selected dishes have different current statuses.</p>
                                    </div>
                                    <fieldset class="dish-status-choices">
                                        <legend>Select dishes</legend>
                                        @foreach (var line in sessionEditableLines)
                                        {
                                            var nextStatus = OrdersModel.NextDishStatus(line.KitchenStatus);
                                            var roundNumber = rounds.FindIndex(order => order.OrderID == line.OrderID) + 1;
                                            <label class="dish-status-option">
                                                <input type="checkbox" name="lineIds" value="@line.OrderLineID" />
                                                <span class="dish-status-dish">
                                                    @line.Quantity × @(RROMS.Services.MenuDisplayNames.InEnglish(line.ItemName))
                                                    <small class="muted">Round @roundNumber</small>
                                                </span>
                                                <span class="dish-active">@line.KitchenStatus → @nextStatus</span>
                                            </label>
                                        }
                                    </fieldset>
                                    <div class="dish-status-actions">
                                        <button type="button" class="secondary" data-select-all>Select all eligible</button>
                                        <button type="button" class="secondary" data-clear-selection>Clear selection</button>
                                        <button type="submit">ADVANCE SELECTED DISHES</button>
                                        <span class="dish-status-hint" role="status">Select at least one dish to update.</span>
                                    </div>
                                </form>
                            </details>
                        }
                        @foreach (var o in rounds)
                        {
                            <section class="staff-kitchen-round">
                                <div class="staff-round-heading">
                                    <div>
                                        <p class="reference">ORDERED @o.CreatedAt.ToString("dd MMM, h:mm tt")</p>
                                        <span class="badge">@DiningOrderPresentation.RoundStatus(o)</span>
                                        <strong class="staff-round-total">RM @(o.Status == "Cancelled" ? "0.00" : o.Total.ToString("N2"))</strong>
                                    </div>

                                </div>
                                @if (!string.IsNullOrWhiteSpace(o.Notes))
                                {
                                    <p class="order-notes">Special request: @o.Notes</p>
                                }
                                @{
                                    var canCancelAnyDish = o.Status != "Cancelled" &&
                                        booking.ReservationStatus == "Seated" && !isPaid &&
                                        o.Lines.Any(l => !l.IsCancelled && OrdersModel.CanCancelDish(l.KitchenStatus));
                                }
                                <div class="table-wrap">
                                    <table class="order-detail-table staff-detail-table @(canCancelAnyDish ? "" : "no-dish-actions")">
                                        <thead>
                                            <tr>
                                                <th>Dish</th>
                                                <th>Qty</th>
                                                <th>Unit Price</th>
                                                <th>Total Price</th>
                                                <th>Status</th>
                                                @if (canCancelAnyDish)
                                                {
                                                    <th>Cancel dish</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                        @foreach (var line in o.Lines.OrderBy(l => l.OrderLineID))
                                        {
                                            var cancelled = line.IsCancelled || o.Status == "Cancelled";
                                            <tr class="@(cancelled ? "cancelled-line" : "")">
                                                <td>@(RROMS.Services.MenuDisplayNames.InEnglish(line.ItemName))</td>
                                                <td>@line.Quantity</td>
                                                <td>RM @line.UnitPrice.ToString("N2")</td>
                                                <td>@(cancelled ? "Excluded" : $"RM {line.LineTotal:N2}")</td>
                                                <td><span class="@(cancelled ? "dish-cancelled" : "dish-active")">@(cancelled ? "Cancelled" : line.KitchenStatus)</span></td>
                                                @if (canCancelAnyDish)
                                                {
                                                    <td>
                                                        @if (!cancelled && OrdersModel.CanCancelDish(line.KitchenStatus))
                                                        {
                                                            <form method="post" asp-page-handler="CancelDish" class="dish-cancel-form"
                                                                  onsubmit="return confirm('Are you sure you want to cancel this one dish? Its cost will be removed from the bill.');">
                                                                <input type="hidden" name="orderLineId" value="@line.OrderLineID" />
                                                                <input type="hidden" name="Search" value="@Model.Search" />
                                                                <button type="submit" class="dish-cancel-button" aria-label="Cancel @line.Quantity × @(RROMS.Services.MenuDisplayNames.InEnglish(line.ItemName))">Cancel Dish</button>
                                                            </form>
                                                        }
                                                        else
                                                        {
                                                            <small class="muted">@(cancelled ? "Already cancelled" : line.KitchenStatus == "Served" ? "Already served" : "Cannot cancel")</small>
                                                        }
                                                    </td>
                                                }
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            </section>
                        }
                    </div>
                </details>
            </section>
        }
    </div>
}

@section Scripts {
    <script>
        document.querySelectorAll('.dish-status-form').forEach(form => {
            const choices = Array.from(form.querySelectorAll('input[name="lineIds"]'));
            const hint = form.querySelector('.dish-status-hint');
            const updateSelectionCount = () => {
                const count = choices.filter(choice => choice.checked && !choice.disabled).length;
                if (hint) hint.textContent = count ? `${count} dish${count === 1 ? '' : 'es'} selected.` : 'Select at least one dish to update.';
            };
            choices.forEach(choice => choice.addEventListener('change', updateSelectionCount));
            form.querySelector('[data-select-all]')?.addEventListener('click', () => {
                choices.forEach(choice => { choice.checked = !choice.disabled; });
                updateSelectionCount();
            });
            form.querySelector('[data-clear-selection]')?.addEventListener('click', () => {
                choices.forEach(choice => { choice.checked = false; });
                updateSelectionCount();
            });
            updateSelectionCount();
            form.addEventListener('submit', event => {
                if (!choices.some(choice => choice.checked && !choice.disabled)) {
                    event.preventDefault();
                    if (hint) hint.textContent = 'Please tick at least one eligible dish.';
                }
            });
        });
    </script>
}

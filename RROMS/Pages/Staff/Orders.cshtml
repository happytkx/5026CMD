@page
@* A reservation is one dining session; expand it to manage each kitchen round and individual dishes. *@
@model RROMS.Pages.Staff.OrdersModel
@{
    ViewData["Title"] = "Dining orders";
    var sessions = Model.Orders.GroupBy(o => o.ReservationID)
        .OrderByDescending(g => g.Max(o => o.CreatedAt)).ToList();
}
<p class="eyebrow">RESTAURANT OPERATIONS</p>
<h1>Dining Orders</h1>
<p>Every reservation appears once. Open View Details to follow the dishes and manage kitchen progress. Update individual dishes as they move through the kitchen. Staff can cancel an unserved dish; cancelled dishes are excluded from billing.</p>
<p><a class="button secondary" asp-page="/Staff/Billing">Go to Billing &amp; Checkout</a></p>
@if (TempData["Success"] is string ok)
{
    <p class="success">@ok</p>
}
@if (TempData["Error"] is string err)
{
    <p class="error">@err</p>
}
<div class="staff-stats">
    <section class="card">
        <small>IN PROGRESS</small>
        <h2>@Model.Orders.Where(o => o.Lines.Any(l => !l.IsCancelled && (l.KitchenStatus is "Received" or "Preparing" or "Ready to Serve"))).Select(o => o.ReservationID).Distinct().Count()</h2>
        <p>Reservations with unserved dishes</p>
    </section>
    <section class="card">
        <small>RECEIVED</small>
        <h2>@Model.Orders.Where(o => o.Lines.Any(l => !l.IsCancelled && l.KitchenStatus == "Received")).Select(o => o.ReservationID).Distinct().Count()</h2>
        <p>Reservations with new dishes</p>
    </section>
    <section class="card">
        <small>READY TO SERVE</small>
        <h2>@Model.Orders.Where(o => o.Lines.Any(l => !l.IsCancelled && l.KitchenStatus == "Ready to Serve")).Select(o => o.ReservationID).Distinct().Count()</h2>
        <p>Reservations ready for service</p>
    </section>
    <section class="card">
        <small>DINING SESSIONS</small>
        <h2>@sessions.Count</h2>
        <p>Recently active reservations</p>
    </section>
</div>

@if (!sessions.Any())
{
    <section class="card empty-state">No dining orders yet.</section>
}
else
{
    <div class="staff-dining-sessions">
        @foreach (var session in sessions)
        {
            var rounds = session.OrderBy(o => o.CreatedAt).ThenBy(o => o.OrderID).ToList();
            var booking = rounds[0].Reservation;
            var customer = rounds[0].Customer;
            var isPaid = Model.PaidReservationIds.Contains(booking.ReservationID);

            <section class="card staff-dining-session">
                <div class="staff-session-header">
                    <div>
                        <p class="reference">RESERVATION · @booking.BookingReference</p>
                        <h2>Table @booking.TableID · @customer.CustomerName</h2>
                        <p class="staff-session-meta">
                            @DiningOrderPresentation.ActiveItemCount(rounds) items ·
                            @rounds.Count ordering round@(rounds.Count == 1 ? "" : "s")
                            · @booking.ReservationDate.ToString("dd MMM yyyy")
                        </p>
                    </div>
                    <div class="staff-session-summary">
                        <span class="badge">@DiningOrderPresentation.Status(rounds)</span>
                        <strong>RM @DiningOrderPresentation.Total(rounds).ToString("N2")</strong>
                        <a asp-page="/Staff/BillDetails" asp-route-id="@booking.ReservationID">View Bill</a>
                    </div>
                </div>

                <details class="staff-session-details" open="@(Model.Expanded == booking.ReservationID)">
                    <summary>
                        <strong>View Details</strong>
                        <span>Items, kitchen status and dish cancellation</span>
                    </summary>
                    <div class="staff-session-details-body">
                        @foreach (var o in rounds)
                        {
                            <section class="staff-kitchen-round">
                                <div class="staff-round-heading">
                                    <div>
                                        <p class="reference">ORDERED @o.CreatedAt.ToString("dd MMM, h:mm tt")</p>
                                        <span class="badge">@DiningOrderPresentation.RoundStatus(o)</span>
                                        <strong class="staff-round-total">RM @(o.Status == "Cancelled" ? "0.00" : o.Total.ToString("N2"))</strong>
                                    </div>

                                </div>
                                @{
                                    var editableLines = o.Lines.Where(line => !line.IsCancelled &&
                                        OrdersModel.NextDishStatus(line.KitchenStatus) != null).OrderBy(line => line.OrderLineID).ToList();
                                    var initialStatus = editableLines.Select(line => OrdersModel.NextDishStatus(line.KitchenStatus))
                                        .FirstOrDefault() ?? "Preparing";
                                }
                                @if (editableLines.Count > 0 && booking.ReservationStatus == "Seated" && !isPaid)
                                {
                                    <details class="dish-status-editor">
                                        <summary>Update status</summary>
                                        <form method="post" asp-page-handler="UpdateDishes" class="dish-status-form">
                                            <input type="hidden" name="orderId" value="@o.OrderID" />
                                            <div class="dish-status-instruction">
                                                <strong>Choose the dishes to update</strong>
                                                <p>Only dishes ready for the next step can be selected. Other dishes keep their current status.</p>
                                            </div>
                                            <div class="dish-status-target">
                                                <label for="target-@o.OrderID">Update selected dishes to</label>
                                                <select id="target-@o.OrderID" name="status">
                                                    @foreach (var target in new[] { "Preparing", "Ready to Serve", "Served" })
                                                    {
                                                        <option value="@target" selected="@(target == initialStatus)">@target</option>
                                                    }
                                                </select>
                                            </div>
                                            <fieldset class="dish-status-choices">
                                                <legend>Select dishes</legend>
                                                @foreach (var line in editableLines)
                                                {
                                                    var nextStatus = OrdersModel.NextDishStatus(line.KitchenStatus);
                                                    <label class="dish-status-option">
                                                        <input type="checkbox" name="lineIds" value="@line.OrderLineID"
                                                               data-next-status="@nextStatus" disabled="@(nextStatus != initialStatus)" />
                                                        <span class="dish-status-dish">@line.Quantity × @line.ItemName</span>
                                                        <span class="dish-active">@line.KitchenStatus</span>
                                                    </label>
                                                }
                                            </fieldset>
                                            <div class="dish-status-actions">
                                                <button type="submit">Done</button>
                                                <span class="dish-status-hint">Select at least one dish to update.</span>
                                            </div>
                                        </form>
                                    </details>
                                }
                                @if (!string.IsNullOrWhiteSpace(o.Notes))
                                {
                                    <p class="order-notes">Special request: @o.Notes</p>
                                }
                                <div class="table-wrap">
                                    <table class="order-detail-table staff-detail-table">
                                        <thead>
                                            <tr>
                                                <th>Dish</th>
                                                <th>Qty</th>
                                                <th>Unit Price</th>
                                                <th>Total Price</th>
                                                <th>Status</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        @foreach (var line in o.Lines.OrderBy(l => l.OrderLineID))
                                        {
                                            var cancelled = line.IsCancelled || o.Status == "Cancelled";
                                            <tr class="@(cancelled ? "cancelled-line" : "")">
                                                <td>@line.ItemName</td>
                                                <td>@line.Quantity</td>
                                                <td>RM @line.UnitPrice.ToString("N2")</td>
                                                <td>@(cancelled ? "Excluded" : $"RM {line.LineTotal:N2}")</td>
                                                <td><span class="@(cancelled ? "dish-cancelled" : "dish-active")">@(cancelled ? "Cancelled" : line.KitchenStatus)</span></td>
                                                <td>
                                                    @if (!cancelled && OrdersModel.CanCancelDish(line.KitchenStatus) && booking.ReservationStatus == "Seated" && !isPaid)
                                                    {
                                                        <form method="post" asp-page-handler="CancelDish" class="dish-cancel-form"
                                                              onsubmit="return confirm('Cancel this dish and remove its cost from the bill?');">
                                                            <input type="hidden" name="orderLineId" value="@line.OrderLineID" />
                                                            <button type="submit" class="dish-cancel-button" aria-label="Cancel @line.Quantity × @line.ItemName">Cancel Dish</button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <small class="muted">@(cancelled ? "Cancelled" : "Unavailable")</small>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            </section>
                        }
                    </div>
                </details>
            </section>
        }
    </div>
}

@section Scripts {
    <script>
        document.querySelectorAll('.dish-status-form').forEach(form => {
            const target = form.querySelector('select[name="status"]');
            const choices = Array.from(form.querySelectorAll('input[name="lineIds"]'));
            const sync = () => {
                choices.forEach(choice => {
                    const allowed = choice.dataset.nextStatus === target.value;
                    choice.disabled = !allowed;
                    if (!allowed) choice.checked = false;
                });
            };
            target.addEventListener('change', sync);
            sync();
            form.addEventListener('submit', event => {
                if (!choices.some(choice => choice.checked && !choice.disabled)) {
                    event.preventDefault();
                    form.querySelector('.dish-status-hint').textContent = 'Please tick at least one eligible dish.';
                }
            });
        });
    </script>
}

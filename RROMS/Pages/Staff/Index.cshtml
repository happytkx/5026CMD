@page
@* Staff workspace dashboard: service totals, date/status/name filters and links to manage each reservation. *@
@model RROMS.Pages.Staff.IndexModel
@{
    ViewData["Title"]="Daily reservations";
}
<p class="eyebrow">YOUR SERVICE OVERVIEW</p>
<h1>Daily Reservations</h1>
<p>View daily bookings, manage deposit confirmation, rescheduling and cancellation, and coordinate guest arrivals.</p>
<section class="staff-stats">
    <article class="card">
        <small>TOTAL RESERVATIONS</small>
        <h2>@Model.DailyBookings.Count</h2>
        <p>Booked across dining areas</p>
    </article>
    <article class="card">
        <small>EXPECTED ARRIVALS</small>
        <h2>@Model.DailyBookings.Count(r=>r.ReservationStatus=="Confirmed")</h2>
        <p>Confirmed bookings for this date, awaiting check-in</p>
    </article>
    <article class="card">
        <a class="text-reset text-decoration-none"
           asp-page="/Staff/Index"
           asp-route-Date="@Model.Date.ToString("yyyy-MM-dd")"
           asp-route-Status="Seated">

            <small>CHECKED IN</small>

            <h2>
                @Model.DailyBookings.Count(
                    r => r.ReservationStatus == "Seated")
            </h2>

            <p>Click to view checked-in reservations</p>

        </a>
    </article>

    <article class="card">
        <small>ATTENTION NEEDED</small>
        <h2>@Model.DailyBookings.Count(r=>r.ReservationStatus=="No-show" || (r.ReservationStatus=="Confirmed" && r.LateArrivalNotified))</h2>
        <p>Late arrivals / no-shows</p>
    </article>
</section>
<section class="card">
    <h3>Reservation Schedule</h3>
    <p>Choose a service date, filter bookings, then open a reservation to manage it. Confirmation requires the agreed deposit (currently RM @Model.CurrentPolicy.DepositPerGuest.ToString("N2") per guest for new reservations).</p>
    <form method="get" class="staff-search">
        <input asp-for="Search" aria-label="Search reference or guest name" placeholder="Search reference or guest name…"/>
        <select asp-for="Status" aria-label="Reservation status">
            <option value="">
                All statuses
            </option>
            @foreach (var s in new[]{"Pending","Confirmed","Seated","Completed","Cancelled","No-show","Expired"})
            {
                <option>
                    @s
                </option>
            }
        </select>
        <input asp-for="Date" type="date" aria-label="Service date"/>
        <button>View</button>
    </form>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>
                        Time / Ref
                    </th>
                    <th>
                        Guest
                    </th>
                    <th>
                        Dining area
                    </th>
                    <th>
                        Party
                    </th>
                    <th>
                        Status
                    </th>
                    <th>
                        Assigned
                    </th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Bookings)
                {
                    <tr>
                        <td>
                            <strong>@r.ReservationDate.Add(r.StartTime).ToString("h:mm tt")</strong>
                            <br/>
                            <small>@r.BookingReference</small>
                        </td>
                        <td>
                            <strong>@r.Customer.CustomerName</strong>
                            @if (r.LateArrivalNotified)
                            {
                                <br/>
                                <small>Late arrival notified</small>
                            }
                        </td>
                        <td>
                            @r.PreferredDiningOption
                        </td>
                        <td>
                            @r.PartySize guests
                        </td>
                        <td>
                            <span class="badge">@r.ReservationStatus</span>
                        </td>
                        <td>
                            @r.TableID
                        </td>
                        <td class="staff-reservation-table-actions">
                            @{
                                var canManageReservation = r.ReservationStatus is "Pending" or "Confirmed";
                            }
                            <a class="button @(canManageReservation ? "" : "secondary") staff-reservation-manage-link"
                               asp-page="/Reservations/Details" asp-route-id="@r.ReservationID"
                               aria-label="@(canManageReservation ? "Manage" : "View details for") reservation @r.BookingReference">
                                @(canManageReservation ? "Manage" : "View details")
                            </a>
                            @if (r.ReservationStatus == "Pending")
                            {
                                <a class="staff-reservation-shortcut" asp-page="/Reservations/Details"
                                   asp-route-id="@r.ReservationID" asp-route-View="Payment">
                                    Collect deposit &amp; confirm
                                </a>
                            }
                            else if (r.ReservationStatus == "Confirmed" &&
                                     ReservationPolicy.CanModify(r.OriginalStart, r.ModificationCount, ReservationPolicy.Now, r.RescheduleCutoffHours, r.MaximumReschedules))
                            {
                                <a class="staff-reservation-shortcut" asp-page="/Reservations/Details"
                                   asp-route-id="@r.ReservationID" asp-route-View="Modify">
                                    Reschedule
                                </a>
                            }
                            @if (r.ReservationStatus == "Confirmed")
                            {
                                <a class="staff-reservation-shortcut" asp-page="/Reservations/Details"
                                   asp-route-id="@r.ReservationID" asp-fragment="staff-guest-arrival">
                                    Guest check-in
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Bookings.Count==0)
    {
        <p>No reservations match this date and filter.</p>
    }
</section>
<p class="notice">Unseated reservations become No-show after their booked grace period (currently @Model.CurrentPolicy.ArrivalGraceMinutes minutes, or @Model.CurrentPolicy.ExtendedArrivalGraceMinutes minutes after a timely late notice for new reservations). The paid deposit is forfeited and the table released.</p>
@section Scripts
{
    <script>
        setTimeout(() => { if (!document.hidden && !document.querySelector('input:focus,select:focus')) location.reload(); }, 30000);
    </script>
}

@page
@model RROMS.Pages.Staff.BillingModel

@{
    ViewData["Title"] = "Billing";
}

<p class="eyebrow">BILLING & PAYMENTS</p>

<h1>Billing &amp; Checkout</h1>
<p>Choose a seated reservation, prepare its final bill, review the total with tax and deposit, then record the full payment received onsite.</p>

<div class="billing-toolbar">
    <a class="button secondary" asp-page="/Staff/Orders">Check Dining Orders</a>
    <a class="button secondary" asp-page="/Staff/BillingHistory">Paid Bills &amp; History</a>
</div>

<section class="billing-workflow" aria-label="Staff billing steps">
    <div><span>01</span><strong>Serve orders</strong><small>Finish all active dining orders.</small></div>
    <div><span>02</span><strong>Prepare final bill</strong><small>Review items, tax, minimum and deposit.</small></div>
    <div><span>03</span><strong>Take payment</strong><small>Record Cash, Card or E-Wallet in full.</small></div>
    <div><span>04</span><strong>Complete dining</strong><small>Close the reservation after settlement.</small></div>
</section>

<section class="card billing-reservations">
    <div class="billing-list-heading">
        <div>
            <h2>Seated Dining Sessions</h2>
            <p>Only checked-in (Seated) reservations appear here. Open a booking to prepare the final bill and record payment.</p>
        </div>
        <a class="button secondary" asp-page="/Staff/Index">Daily Reservations</a>
    </div>

    @if (Model.SeatedReservations.Count == 0)
    {
        <p>No seated reservations are available yet. Check in a confirmed guest from Daily Reservations to begin billing.</p>
        <a class="button" asp-page="/Staff/Index">Open Daily Reservations</a>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Booking Reference</th>
                        <th>Customer</th>
                        <th>Dining Option</th>
                        <th>Guests</th>
                        <th>Minimum Spend</th>
                        <th>Deposit Paid</th>
                        <th>Bill Total</th>
                        <th>Balance to Pay</th>
                        <th>Bill Status</th>
                        <th>Next Step</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var reservation in Model.SeatedReservations)
                    {
                        Model.BillsByReservationId.TryGetValue(
                            reservation.ReservationID,
                            out var bill);

                        <tr>
                            <td>@reservation.BookingReference</td>

                            <td>@reservation.Customer.CustomerName</td>

                            <td>@reservation.PreferredDiningOption</td>

                            <td>@reservation.PartySize</td>

                            <td>
                                RM @reservation.MinimumSpend.ToString("N2")
                            </td>

                            <td>
                                RM @reservation.DepositAmount.ToString("N2")
                            </td>

                            @if (bill == null)
                            {
                                <td>Not available</td>
                                <td>Not available</td>
                                <td>Awaiting orders</td>
                            }
                            else
                            {
                                <td>
                                    RM @bill.TotalBill.ToString("N2")
                                </td>

                                <td>RM @(bill.BillStatus == "Paid" ? "0.00" : bill.BalanceToPay.ToString("N2"))</td>

                                <td><span class="celeste-bill-status @(bill.BillStatus == "Paid" ? "celeste-bill-status-paid" : "celeste-bill-status-draft")">@(bill.BillStatus == "Draft" ? "Awaiting Payment" : bill.BillStatus)</span></td>
                            }

                            
                            <td class="billing-actions">
                                <a class="button @(bill?.BillStatus == "Paid" ? "secondary" : "")"
                                   asp-page="/Staff/BillDetails"
                                   asp-route-id="@reservation.ReservationID"
                                   asp-fragment="dining-bill">
                                    @(bill == null ? "Prepare Final Bill" : bill.BillStatus == "Paid" ? "View Paid Bill" : "Review & Take Payment")
                                </a>
                                <a asp-page="/Reservations/Details" asp-route-id="@reservation.ReservationID">
                                    @(bill?.BillStatus == "Paid" ? "Complete Reservation" : "View Reservation")
                                </a>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p class="notice">
            Payment is recorded inside each reservation's Bill Details page. Customers can only view estimates and their receipts; staff handles onsite checkout.
        </p>
    }
</section>

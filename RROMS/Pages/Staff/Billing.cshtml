@page
@model RROMS.Pages.Staff.BillingModel

@{
    ViewData["Title"] = "Billing";
}

<p class="eyebrow">BILLING & PAYMENTS</p>

<h1>Billing</h1>

<p>
    View seated reservations, minimum spending,
    deposits and saved dining bills.
</p>

<section class="card">
    <h2>Seated Reservations</h2>

    @if (Model.SeatedReservations.Count == 0)
    {
        <p>No seated reservations found.</p>

        <a asp-page="/Staff/Index">
            View Daily Reservations
        </a>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Booking Reference</th>
                        <th>Customer</th>
                        <th>Dining Option</th>
                        <th>Guests</th>
                        <th>Minimum Spend</th>
                        <th>Deposit Paid</th>
                        <th>Bill Total</th>
                        <th>Balance to Pay</th>
                        <th>Bill Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var reservation in Model.SeatedReservations)
                    {
                        Model.BillsByReservationId.TryGetValue(
                            reservation.ReservationID,
                            out var bill);

                        <tr>
                            <td>@reservation.BookingReference</td>

                            <td>@reservation.Customer.CustomerName</td>

                            <td>@reservation.PreferredDiningOption</td>

                            <td>@reservation.PartySize</td>

                            <td>
                                RM @reservation.MinimumSpend.ToString("N2")
                            </td>

                            <td>
                                RM @reservation.DepositAmount.ToString("N2")
                            </td>

                            @if (bill == null)
                            {
                                <td>Not available</td>
                                <td>Not available</td>
                                <td>Awaiting orders</td>
                            }
                            else
                            {
                                <td>
                                    RM @bill.TotalBill.ToString("N2")
                                </td>

                                <td>
                                    RM @bill.BalanceToPay.ToString("N2")
                                </td>

                                <td>@bill.BillStatus</td>
                            }

                            
                            <td>
                                <a asp-page="/Staff/BillDetails"
                                   asp-route-id="@reservation.ReservationID">
                                    View Bill & Payments
                                </a>

                                <a asp-page="/Reservations/Details"
                                   asp-route-id="@reservation.ReservationID">
                                    View Reservation
                                </a>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p class="notice">
            Bill totals will be generated from actual
            food and beverage orders after integration
            with the ordering module.

            A saved draft bill can be displayed here,
            but this page does not process payments.
        </p>
    }
</section>

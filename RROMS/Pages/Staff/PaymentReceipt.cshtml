@page "{id:int}"
@model RROMS.Pages.Staff.PaymentReceiptModel

@{
    var payment = Model.Payment!;
    var booking = payment.Reservation;
    var isDeposit = payment.PaymentType == "Deposit";
    var bill = Model.DiningBill;

    ViewData["Title"] = "Payment Receipt";
}

<div class="receipt-actions">
    <a asp-page="@(Model.IsStaff ? "/Staff/BillDetails" : "/MyBill")"
       asp-route-id="@booking.ReservationID">← @(Model.IsStaff ? "Back to Bill Details" : "Back to My Bill")</a>
    <button type="button" onclick="window.print()">Print / Save as PDF</button>
</div>

<article class="card receipt-sheet" aria-label="Céleste payment receipt">
    <header class="receipt-header">
        <div>
            <p class="receipt-brand">CÉLESTE <span>FINE DINING</span></p>
            <h1>@(isDeposit ? "Reservation Deposit Receipt" : "Final Dining Receipt")</h1>
            <p class="receipt-subtitle">@(isDeposit ? "Your reservation deposit has been received." : "An itemised record of your dining experience and final payment.")</p>
        </div>
        <span class="receipt-paid">✓ PAID</span>
    </header>

    <div class="receipt-reference-bar">
        <div>
            <small>RECEIPT NO.</small>
            <strong>PAY-@payment.PaymentID.ToString("D6")</strong>
        </div>
        <div>
            <small>PAYMENT DATE</small>
            <strong>@payment.PaymentDate.ToString("dd MMM yyyy, h:mm tt")</strong>
        </div>
        @if (bill is not null)
        {
            <div>
                <small>BILL NO.</small>
                <strong>#@bill.BillID</strong>
            </div>
        }
    </div>

    <div class="receipt-meta-grid">
        <section class="receipt-details">
            <h2>Reservation</h2>
            <dl>
                <div><dt>Booking reference</dt><dd>@booking.BookingReference</dd></div>
                <div><dt>Customer</dt><dd>@booking.Customer.CustomerName</dd></div>
                <div><dt>Dining date</dt><dd>@booking.ReservationDate.ToString("dd MMM yyyy")</dd></div>
                <div><dt>Dining area</dt><dd>@booking.PreferredDiningOption</dd></div>
                <div><dt>Guests</dt><dd>@booking.PartySize</dd></div>
                @if (!string.IsNullOrWhiteSpace(booking.TableID))
                {
                    <div><dt>Assigned table</dt><dd>@booking.TableID</dd></div>
                }
            </dl>
        </section>
        <section class="receipt-details">
            <h2>Payment</h2>
            <dl>
                <div><dt>Payment type</dt><dd>@(isDeposit ? "Reservation deposit" : "Final dining payment")</dd></div>
                <div><dt>Payment method</dt><dd>@(payment.PaymentMethod == "EWallet" ? "E-Wallet" : payment.PaymentMethod)</dd></div>
                <div><dt>Payment reference</dt><dd>@(string.IsNullOrWhiteSpace(payment.PaymentReference) ? "Not provided" : payment.PaymentReference)</dd></div>
                <div><dt>Status</dt><dd class="receipt-status-text">@payment.PaymentStatus</dd></div>
            </dl>
        </section>
    </div>

    @if (!isDeposit)
    {
        <section class="receipt-section" aria-labelledby="receipt-dishes-heading">
            <div class="receipt-section-title">
                <h2 id="receipt-dishes-heading">Ordered Dishes</h2>
                <span>@(Model.Dishes.Sum(item => item.Quantity)) items</span>
            </div>
            @if (Model.Dishes.Count == 0)
            {
                <p class="receipt-empty">No billable dining items were found for this reservation.</p>
            }
            else
            {
                <div class="receipt-table-wrap">
                    <table class="receipt-lines">
                        <thead>
                            <tr>
                                <th>Dish</th>
                                <th class="receipt-number">Qty</th>
                                <th class="receipt-number">Unit Price</th>
                                <th class="receipt-number">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Dishes)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td class="receipt-number">@item.Quantity</td>
                                    <td class="receipt-number">RM @item.UnitPrice.ToString("N2")</td>
                                    <td class="receipt-number">RM @item.TotalPrice.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        @if (bill is not null)
        {
            <section class="receipt-section receipt-summary" aria-labelledby="receipt-summary-heading">
                <h2 id="receipt-summary-heading">Charges &amp; Payments</h2>
                <dl>
                    <div><dt>Food &amp; Beverage Subtotal</dt><dd>RM @bill.FoodSubtotal.ToString("N2")</dd></div>
                    <div><dt>Tax (6%)</dt><dd>RM @bill.TaxAmount.ToString("N2")</dd></div>
                    <div class="receipt-summary-total"><dt>Grand Total</dt><dd>RM @bill.TotalBill.ToString("N2")</dd></div>
                    @if (bill.MinSpend > 0)
                    {
                        <div><dt>Minimum Spending Requirement</dt><dd>RM @bill.MinSpend.ToString("N2")</dd></div>
                    }
                    <div><dt>Reservation Deposit Applied</dt><dd>− RM @bill.DepositApplied.ToString("N2")</dd></div>
                    <div><dt>Final Payment Received</dt><dd>− RM @payment.Amount.ToString("N2")</dd></div>
                    <div class="receipt-summary-balance"><dt>Outstanding Balance</dt><dd>RM @Model.OutstandingBalance.ToString("N2")</dd></div>
                </dl>
            </section>
        }
        else
        {
            <p class="receipt-empty">The original final bill breakdown is unavailable. The confirmed payment details below remain valid.</p>
        }
    }

    <section class="receipt-amount" aria-label="Confirmed payment amount">
        <div>
            <span>@(isDeposit ? "RESERVATION DEPOSIT RECEIVED" : "FINAL DINING PAYMENT RECEIVED")</span>
            <strong>RM @payment.Amount.ToString("N2")</strong>
        </div>
        <span class="receipt-amount-check" aria-hidden="true">✓</span>
    </section>

    @if (isDeposit)
    {
        <p class="receipt-policy">The reservation deposit is normally deducted from the final dining bill. If the reservation is cancelled or treated as a no-show, the deposit is forfeited under Céleste's reservation policy.</p>
    }
    else
    {
        <p class="receipt-policy">The reservation deposit was collected separately and is shown above as a deduction from the dining total. This receipt records the final payment received by Céleste.</p>
    }

    <footer class="receipt-footer">
        <strong>Thank you for dining with Céleste.</strong>
        <span>Please keep this receipt for your records.</span>
    </footer>
</article>

<style>
    .receipt-actions {
        max-width: 850px;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }

    .receipt-actions a {
        color: #656d4e;
        text-underline-offset: 4px;
    }

    .receipt-sheet {
        max-width: 850px;
        margin: 0 auto 36px;
        padding: 40px 46px;
        color: #302e29;
        background: #fff;
        border: 1px solid #e2d9ca;
        box-shadow: 0 14px 35px rgba(46, 38, 27, .05);
    }

    .receipt-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 24px;
        padding-bottom: 24px;
        border-bottom: 2px solid #686e50;
    }

    .receipt-brand {
        margin: 0 0 14px;
        color: #a37544;
        font-size: .85rem;
        font-weight: 700;
        letter-spacing: .2em;
    }

    .receipt-brand span {
        color: #8a8072;
        font-size: .67rem;
        letter-spacing: .13em;
    }

    .receipt-header h1 {
        font-size: clamp(2rem, 3.2vw, 2.75rem);
        line-height: 1.13;
        margin: 0 0 9px;
    }

    .receipt-subtitle {
        color: #777167;
        margin: 0;
        line-height: 1.5;
    }

    .receipt-paid {
        display: inline-block;
        padding: 8px 14px;
        border-radius: 3px;
        background: #e9eee2;
        color: #526342;
        border: 1px solid #bdc9b2;
        font-weight: 700;
        font-size: .75rem;
        letter-spacing: .15em;
        white-space: nowrap;
    }

    .receipt-reference-bar {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 14px 26px;
        padding: 20px 0;
        border-bottom: 1px solid #e6dfd5;
    }

    .receipt-reference-bar > div {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .receipt-reference-bar small {
        color: #847b6d;
        letter-spacing: .11em;
        font-size: .67rem;
    }

    .receipt-reference-bar strong {
        font-size: .91rem;
        font-weight: 600;
    }

    .receipt-meta-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 34px;
        padding: 22px 0 6px;
    }

    .receipt-details h2,
    .receipt-section h2 {
        font-size: 1.48rem;
        margin: 0 0 15px;
    }

    .receipt-details dl,
    .receipt-summary dl {
        margin: 0;
    }

    .receipt-details dl > div {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        padding: 8px 0;
        border-bottom: 1px solid #f0eae2;
        font-size: .85rem;
    }

    .receipt-details dt,
    .receipt-summary dt {
        color: #756f65;
    }

    .receipt-details dd,
    .receipt-summary dd {
        margin: 0;
        text-align: right;
        overflow-wrap: anywhere;
    }

    .receipt-details dd {
        max-width: 57%;
        font-weight: 500;
    }

    .receipt-status-text {
        color: #536341;
        font-weight: 700 !important;
    }

    .receipt-section {
        margin-top: 26px;
    }

    .receipt-section-title {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 12px;
    }

    .receipt-section-title span {
        color: #80776b;
        font-size: .82rem;
    }

    .receipt-table-wrap {
        overflow-x: auto;
        border: 1px solid #e3dacd;
        border-radius: 4px;
    }

    .receipt-lines {
        width: 100%;
        border-collapse: collapse;
        font-size: .87rem;
    }

    .receipt-lines th {
        background: #eee9df;
        color: #48443c;
        font-size: .72rem;
        text-transform: uppercase;
        letter-spacing: .06em;
        font-weight: 600;
    }

    .receipt-lines th,
    .receipt-lines td {
        padding: 11px 13px;
        border-bottom: 1px solid #e9e1d7;
        text-align: left;
    }

    .receipt-lines tbody tr:last-child td {
        border-bottom: 0;
    }

    .receipt-lines .receipt-number {
        text-align: right;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    .receipt-summary {
        max-width: 450px;
        margin-left: auto;
    }

    .receipt-summary dl > div {
        display: flex;
        justify-content: space-between;
        gap: 22px;
        padding: 9px 0;
        font-size: .91rem;
    }

    .receipt-summary dd {
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    .receipt-summary-total {
        border-top: 1px solid #ded5c7;
        padding-top: 15px !important;
        font-weight: 700;
    }

    .receipt-summary-balance {
        margin-top: 5px;
        padding: 13px !important;
        background: #ecefe6;
        color: #48583a;
        font-weight: 700;
    }

    .receipt-summary-balance dt {
        color: inherit;
    }

    .receipt-amount {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-top: 26px;
        padding: 22px 25px;
        background: #f3f0e9;
        border-left: 4px solid #68704f;
    }

    .receipt-amount > div {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .receipt-amount span {
        color: #6c665b;
        font-size: .72rem;
        letter-spacing: .12em;
    }

    .receipt-amount strong {
        font-family: Georgia, serif;
        font-size: 2rem;
        font-weight: 400;
        font-variant-numeric: tabular-nums;
    }

    .receipt-amount-check {
        color: #526342 !important;
        font-size: 1.7rem !important;
    }

    .receipt-policy {
        margin: 18px 0 0;
        color: #786f62;
        font-size: .8rem;
        line-height: 1.65;
    }

    .receipt-empty {
        padding: 14px;
        color: #797168;
        background: #f7f4ef;
    }

    .receipt-footer {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 7px;
        margin-top: 30px;
        padding-top: 22px;
        border-top: 1px solid #e1d9cd;
        text-align: center;
    }

    .receipt-footer strong {
        font-family: Georgia, serif;
        font-size: 1.15rem;
        font-weight: 400;
    }

    .receipt-footer span {
        color: #80776b;
        font-size: .8rem;
    }

    @@media (max-width: 650px) {
        .receipt-sheet { padding: 25px 18px; }
        .receipt-header { flex-direction: column; gap: 12px; }
        .receipt-meta-grid { grid-template-columns: 1fr; gap: 24px; }
        .receipt-lines th, .receipt-lines td { padding: 9px 7px; font-size: .77rem; }
        .receipt-amount strong { font-size: 1.65rem; }
        .receipt-actions { flex-wrap: wrap; }
    }

    @@media print {
        @@page { size: A4; margin: 12mm; }

        .staff-sidebar, .workspace-bar, .welcome-bar, .site-header,
        .site-footer, .receipt-actions, .skip-link,
        nav, aside[aria-label="Staff navigation"] { display: none !important; }

        body, main {
            background: white !important;
            color: black !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .receipt-sheet {
            width: 100% !important;
            max-width: none !important;
            padding: 0 !important;
            margin: 0 !important;
            border: 0 !important;
            box-shadow: none !important;
        }

        .receipt-header h1 { font-size: 24pt; }
        .receipt-details h2, .receipt-section h2 { font-size: 15pt; }
        .receipt-reference-bar { gap: 12px; }
        .receipt-meta-grid { grid-template-columns: 1fr 1fr; gap: 24px; }
        .receipt-lines { font-size: 9pt; }
        .receipt-lines th, .receipt-lines td { padding: 7px 8px; }
        .receipt-lines thead { display: table-header-group; }
        .receipt-lines tr, .receipt-amount, .receipt-footer { break-inside: avoid; }
        .receipt-table-wrap { overflow: visible; }
        .receipt-summary { break-inside: avoid; }
        .receipt-paid, .receipt-summary-balance, .receipt-amount,
        .receipt-lines th {
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
    }
</style>

@page
@* Customer notification inbox for dining-order updates. Unread messages stay highlighted until marked as read. *@
@model RROMS.Pages.NotificationsModel
@{
    ViewData["Title"] = "Notifications";
}
<section class="account-heading">
    <p class="eyebrow">YOUR CÉLESTE UPDATES</p>
    <h1>Notifications</h1>
    <p>Dining-order updates from the restaurant. Reservation updates appear on each booking's details page.</p>
</section>

<div class="customer-notifications-toolbar">
    <p class="muted">@(Model.UnreadCount == 0 ? "You're all caught up." : $"{Model.UnreadCount} unread notification{(Model.UnreadCount == 1 ? "" : "s")}")</p>
    @if (Model.UnreadCount > 0)
    {
        <form method="post" asp-page-handler="MarkAllRead">
            <button type="submit" class="secondary">Mark all as read (@Model.UnreadCount)</button>
        </form>
    }
</div>

@if (Model.Items.Count > 0)
{
    <section class="card customer-notifications-list" aria-label="Your notifications">
        @foreach (var n in Model.Items)
        {
            <article class="customer-notification-item @(n.IsRead ? "" : "unread")">
                <div class="customer-notification-content">
                    <p class="customer-notification-meta">
                        <span>@n.CreatedAt.ToString("dd MMM yyyy, h:mm tt")</span>
                        @if (!n.IsRead) { <span class="staff-alert-new">New</span> }
                    </p>
                    <h2>@n.Title</h2>
                    <p>@n.Message</p>
                    @if (n.RelatedOrderID.HasValue)
                    {
                        <a asp-page="/Orders/Index">View my orders →</a>
                    }
                </div>
                @if (!n.IsRead)
                {
                    <form method="post" asp-page-handler="MarkRead">
                        <input type="hidden" name="id" value="@n.CustomerNotificationID" />
                        <button type="submit" class="secondary">Mark as read</button>
                    </form>
                }
            </article>
        }
    </section>
}
else
{
    <section class="card empty-state">You have no notifications yet. Order updates will appear here.</section>
}

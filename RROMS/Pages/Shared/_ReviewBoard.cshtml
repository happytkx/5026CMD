@* Review summary, filters, review cards and pager shared by the admin, staff and public review pages. Moderation controls appear only for admin and staff. *@
@model ReviewBoardView
@{
    var board = Model.Page;
    var summary = board.Summary;
    var list = board.Reviews;
    var noun = "reviews";
}
@if (Model.Moderation)
{
    @if (TempData["Success"] is string moderationOk)
    {
        <p class="success">@moderationOk</p>
    }
    @if (TempData["Error"] is string moderationError)
    {
        <p class="error">@moderationError</p>
    }
}
<section class="review-summary card" aria-label="Rating summary">
    <div class="review-average">
        <strong>@(summary.Total == 0 ? "–" : summary.Average.ToString("0.0"))</strong>
        <partial name="_ReviewStars" model="(int)Math.Round(summary.Average, MidpointRounding.AwayFromZero)" />
        <small>@summary.Total @(summary.Total == 1 ? "review" : "reviews")</small>
        @if (Model.Moderation && summary.HiddenCount > 0)
        {
            <small>@summary.HiddenCount hidden from guests</small>
        }
    </div>
    <ul class="review-bars" aria-label="Ratings breakdown">
        @for (var star = 5; star >= 1; star--)
        {
            <li>
                <a asp-page="@Model.PagePath" asp-route-Rating="@star" asp-route-Show="@board.Show" class="@(board.Rating == star ? "active" : "")"
                   aria-label="Show @star-star reviews (@summary.CountFor(star))">
                    <span>@star ★</span>
                    <span class="review-bar"><span style="width:@(summary.PercentFor(star))%"></span></span>
                    <span>@summary.CountFor(star)</span>
                </a>
            </li>
        }
    </ul>
</section>

<form method="get" asp-page="@Model.PagePath" class="filters review-filters">
    <label for="review-rating">Filter by rating</label>
    <select id="review-rating" name="Rating" onchange="this.form.requestSubmit()">
        <option value="">All ratings</option>
        @for (var star = 5; star >= 1; star--)
        {
            <option value="@star" selected="@(board.Rating == star)">@star @(star == 1 ? "star" : "stars")</option>
        }
    </select>
    @if (Model.Moderation)
    {
        <label for="review-show">Visibility</label>
        <select id="review-show" name="Show" onchange="this.form.requestSubmit()">
            <option value="">All reviews</option>
            <option value="visible" selected="@(board.Show == "visible")">Visible to guests</option>
            <option value="hidden" selected="@(board.Show == "hidden")">Hidden from guests</option>
        </select>
    }
    <button type="submit">Apply</button>
    <a class="button secondary" asp-page="@Model.PagePath">Clear</a>
    <span class="review-count">@list.Total @(list.Total == 1 ? "review" : "reviews") shown</span>
</form>

@if (list.Items.Count == 0)
{
    <section class="card empty-state">
        @if (board.Rating.HasValue || board.Show is not null)
        {
            <text>No reviews match these filters.</text>
        }
        else
        {
            <text>No reviews have been submitted yet. They appear here once guests rate a completed order.</text>
        }
    </section>
}
else
{
    <section class="review-list" aria-label="Customer reviews">
        @foreach (var review in list.Items)
        {
            <article class="card review-card @(review.IsHidden ? "review-hidden" : "")">
                <header>
                    <partial name="_ReviewStars" model="review.Rating" />
                    <time datetime="@review.CreatedAt.ToString("yyyy-MM-dd")">@review.CreatedAt.ToString("dd MMM yyyy")</time>
                </header>
                <p class="review-comment">@review.Comment</p>
                <footer>
                    <strong>@(Model.FullNames ? review.CustomerName : review.FirstName)</strong>
                    @if (Model.Public)
                    {
                        <span class="badge review-verified">Verified dining</span>
                    }
                    @if (review.IsHidden)
                    {
                        <span class="badge review-hidden-badge">Hidden from guests@(string.IsNullOrWhiteSpace(review.HiddenBy) ? "" : " · by " + review.HiddenBy)</span>
                    }
                    @if (Model.ShowOrder)
                    {
                        <small>Order <span class="reference">@review.OrderReference</span></small>
                    }
                    @if (Model.Moderation)
                    {
                        <form method="post" asp-page="@Model.PagePath" asp-page-handler="Visibility" class="review-moderate">
                            <input type="hidden" name="id" value="@review.ReviewID" />
                            <input type="hidden" name="hide" value="@(review.IsHidden ? "false" : "true")" />
                            <input type="hidden" name="Rating" value="@board.Rating" />
                            <input type="hidden" name="Show" value="@board.Show" />
                            <input type="hidden" name="p" value="@list.PageNumber" />
                            <button type="submit" class="secondary">@(review.IsHidden ? "Show to guests" : "Hide from guests")</button>
                        </form>
                    }
                </footer>
            </article>
        }
    </section>
    @if (list.TotalPages > 1)
    {
        <nav class="review-pager" aria-label="Review pages">
            @if (list.PageNumber > 1)
            {
                <a class="button secondary" asp-page="@Model.PagePath" asp-route-Rating="@board.Rating" asp-route-Show="@board.Show" asp-route-p="@(list.PageNumber - 1)">&larr; Newer</a>
            }
            <span>Page @list.PageNumber of @list.TotalPages</span>
            @if (list.PageNumber < list.TotalPages)
            {
                <a class="button secondary" asp-page="@Model.PagePath" asp-route-Rating="@board.Rating" asp-route-Show="@board.Show" asp-route-p="@(list.PageNumber + 1)">Older &rarr;</a>
            }
        </nav>
    }
}

@* Shared page shell: Céleste header/footer for customer pages and sidebar navigation for staff reservation pages; loads fonts and the common stylesheet. *@
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject RROMS.Data.ApplicationDbContext NotificationDb
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var admin = User.IsInRole("Administrator");
    var staff = User.IsInRole("Restaurant Staff") || User.IsInRole("Staff") || admin;
    var workspace = staff && (currentPage.StartsWith("/Staff") || currentPage.StartsWith("/Admin") || currentPage == "/Reservations/Details");
    var unreadStaffNotifications = 0;
    if (workspace)
    {
        var recipientKey = User.FindFirstValue(ClaimTypes.NameIdentifier);
        var isAdministrator = User.IsInRole("Administrator");
        if (!string.IsNullOrWhiteSpace(recipientKey))
        {
            unreadStaffNotifications = await NotificationDb.StaffNotifications.AsNoTracking()
                .CountAsync(n => (n.Audience == "Staff" || (isAdministrator && n.Audience == "Administrator")) &&
                    !NotificationDb.StaffNotificationReads.Any(r =>
                        r.StaffNotificationID == n.StaffNotificationID && r.RecipientKey == recipientKey));
        }
    }
}
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#F7F4EE" />
        <title>
            @ViewData["Title"] · Céleste
        </title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
        <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@400;500;600&family=Playfair+Display:wght@400;500&display=swap" rel="stylesheet" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
        
        @if (workspace)
        {
            <link rel="stylesheet"
                  href="https://cdn.jsdelivr.net/npm/tom-select@@2.6.2/dist/css/tom-select.default.min.css" />
        }

        <link rel="stylesheet" href="~/css/reservations.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/ordering.css" asp-append-version="true" />
    </head>
    <body class="@(workspace ? "staff-workspace" : "guest-view")">
        <a class="skip-link" href="#main-content">
            Skip to content
        </a>
        @if (workspace)
        {
            <aside class="staff-sidebar">
                <a class="brand" asp-page="/Staff/Index">
                    <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 0C13.5 8.5 15.5 10.5 24 12C15.5 13.5 13.5 15.5 12 24C10.5 15.5 8.5 13.5 0 12C8.5 10.5 10.5 8.5 12 0Z"/>
                    </svg>
                    <span>CÉLESTE</span>
                    <small>FINE DINING</small>
                </a>
                @if (admin)
                {
                    <p class="sidebar-label">ADMINISTRATOR MODULE</p>
                    <nav aria-label="Administrator navigation">
                        <a class="@(currentPage == "/Admin/Index" ? "active" : "")" asp-page="/Admin/Index">
                            Admin Dashboard
                        </a>
                        <a class="@(currentPage == "/Admin/Reports" || currentPage == "/Admin/ReportReservations" ? "active" : "")" asp-page="/Admin/Reports">
                            Reservation Reports
                        </a>
                        <a class="@(currentPage == "/Admin/PaymentCollections" ? "active" : "")" asp-page="/Admin/PaymentCollections">
                            Payment Collections
                        </a>
                        <a class="@(currentPage == "/Admin/MenuManagement" || currentPage == "/Admin/MenuPerformance" ? "active" : "")" asp-page="/Admin/MenuManagement">
                            Menu &amp; Performance
                        </a>
                        <a class="@(currentPage == "/Admin/CustomerReviews" ? "active" : "")" asp-page="/Admin/CustomerReviews">
                            Customer Reviews
                        </a>
                        <a class="@(currentPage == "/Admin/TableManagement" ? "active" : "")" asp-page="/Admin/TableManagement">
                            Table Management
                        </a>
                        <a class="@(currentPage == "/Admin/Occupancy" ? "active" : "")" asp-page="/Admin/Occupancy">
                            Table Utilisation
                        </a>
                    </nav>
                    <p class="sidebar-label sidebar-group-divider">SHARED STAFF OPERATIONS</p>
                    <p class="sidebar-group-description">Admin access to daily restaurant operations</p>
                }
                else
                {
                    <p class="sidebar-label">RESTAURANT STAFF MODULE</p>
                }
                <nav aria-label="Restaurant staff operations">
                    <a class="@(currentPage == "/Staff/Index" ? "active" : "")" asp-page="/Staff/Index">
                        Daily Reservations
                    </a>
                    <a class="@(currentPage == "/Staff/Seating" ? "active" : "")" asp-page="/Staff/Seating">
                        Seating &amp; Allocation
                    </a>
                    <a class="@(currentPage == "/Staff/Orders" ? "active" : "")" asp-page="/Staff/Orders">
                        Dining Orders
                    </a>
                    <a class="@(currentPage == "/Staff/Billing" || currentPage == "/Staff/BillDetails" || currentPage == "/Staff/BillingHistory" || currentPage == "/Staff/PaymentReceipt" ? "active" : "")" asp-page="/Staff/Billing">
                        Billing &amp; Checkout
                    </a>
                    <a class="@(currentPage == "/Staff/CustomerReviews" ? "active" : "")" asp-page="/Staff/CustomerReviews">
                        Customer Reviews
                    </a>
                    <a class="@(currentPage == "/Staff/Notifications" ? "active" : "")" asp-page="/Staff/Notifications">
                        Notifications
                        @if (unreadStaffNotifications > 0)
                        {
                            <span class="staff-alert-count">@(unreadStaffNotifications > 99 ? "99+" : unreadStaffNotifications.ToString())</span>
                        }
                    </a>
                </nav>
                <p class="sidebar-label sidebar-group-divider">QUICK LINKS</p>
                <nav aria-label="Other pages">
                    <a asp-page="/Index">View Customer Website</a>
                </nav>
                <div class="staff-account">
                    <strong>@(admin ? "ADMIN ACCOUNT" : "STAFF ACCOUNT")</strong>
                    <p>@(User.Identity?.Name ?? "Restaurant Staff")</p>
                    <form method="post" asp-page="/Account/Logout">
                        <button class="quiet">Sign out</button>
                    </form>
                </div>
            </aside>
            <div class="workspace-bar">
                CÉLESTE / RESERVATION MANAGEMENT
                <span class="workspace-bar-right">
                    @(admin ? "Administrator · Shared staff access" : "Restaurant Staff")
                    <a asp-page="/Staff/Notifications" class="staff-notification-bell" aria-label="Staff notifications@(unreadStaffNotifications > 0 ? $": {unreadStaffNotifications} unread" : "")" title="Notifications">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
                            <path d="M10 21h4" />
                        </svg>
                        @if (unreadStaffNotifications > 0) { <span class="staff-alert-count">@(unreadStaffNotifications > 99 ? "99+" : unreadStaffNotifications.ToString())</span> }
                    </a>
                </span>
            </div>
        }
        <div class="welcome-bar">
            CONTEMPORARY FINE DINING
            <span aria-hidden="true">·</span>
            MOMENTS TO SAVOUR
        </div>
        <header class="site-header">
            <a class="brand" asp-page="/Index" aria-label="Céleste Fine Dining home">
                <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 0C13.5 8.5 15.5 10.5 24 12C15.5 13.5 13.5 15.5 12 24C10.5 15.5 8.5 13.5 0 12C8.5 10.5 10.5 8.5 12 0Z" />
                </svg>
                <span>CÉLESTE</span>
                <small>FINE DINING</small>
            </a>
            <button type="button" class="mobile-menu-toggle" aria-label="Open navigation menu" aria-controls="main-navigation" aria-expanded="false">
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
            </button>
            <nav id="main-navigation" aria-label="Main navigation">
                <a asp-page="/Index" class="@(currentPage == "/Index" ? "active" : "")" aria-current="@(currentPage == "/Index" ? "page" : null)">
                    Home
                </a>
                @if (staff)
                {
                    @if (admin)
                    {
                        <a asp-page="/Admin/Index" class="@(currentPage.StartsWith("/Admin") ? "active" : "")">
                            Admin dashboard
                        </a>
                        <a asp-page="/Staff/Index" class="@(currentPage.StartsWith("/Staff") || currentPage == "/Reservations/Details" ? "active" : "")">
                            Staff operations
                        </a>
                    }
                    else
                    {
                        <a asp-page="/Staff/Index" class="@(currentPage.StartsWith("/Staff") ? "active" : "")">
                            Staff workspace
                        </a>
                    }
                }
                else
                {
                    <a asp-page="/Menu" class="@(currentPage == "/Menu" ? "active" : "")">
                        Menu
                    </a>
                    <a asp-page="/Reviews" class="@(currentPage == "/Reviews" ? "active" : "")">
                        Reviews
                    </a>
                    @if (User.IsInRole("Customer"))
                    {
                        <a asp-page="/MyBill" class="@(currentPage == "/MyBill" ? "active" : "")">
                            My bill
                        </a>
                        <a asp-page="/Reservations/Index" class="@(currentPage == "/Reservations/Index" ? "active" : "")">
                            My reservations
                        </a>
                    }
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-page="/Orders/Index" class="@(currentPage.StartsWith("/Orders") ? "active" : "")">
                            My orders
                        </a>
                        <a asp-page="/Notifications"
                           class="nav-icon-link @(currentPage == "/Notifications" ? "active" : "")"
                           aria-label="Notifications" title="Notifications"
                           aria-current="@(currentPage == "/Notifications" ? "page" : null)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
                                <path d="M10 21h4" />
                            </svg>
                        </a>
                        <a asp-page="/Account/Profile"
                           class="nav-icon-link @(currentPage == "/Account/Profile" ? "active" : "")"
                           aria-label="Profile" title="Profile"
                           aria-current="@(currentPage == "/Account/Profile" ? "page" : null)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="9" />
                                <circle cx="12" cy="9" r="3" />
                                <path d="M6.5 19c.5-3.2 2.8-5 5.5-5s5 1.8 5.5 5" />
                            </svg>
                        </a>
                    }
                }
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (!staff)
                    {
                        <a class="button nav-book" asp-page="/Reservations/Create">
                            Book a table
                        </a>
                    }
                    <form method="post" asp-page="/Account/Logout" class="nav-signout">
                        <button class="quiet">Sign out</button>
                    </form>
                }
                else
                {
                    <a asp-page="/Account/Login" class="@(currentPage == "/Account/Login" ? "active" : "")">
                        Sign in
                    </a>
                    <a asp-page="/Account/Register" class="@(currentPage == "/Account/Register" ? "active" : "")">
                        Register
                    </a>
                    @if (!staff)
                    {
                        <a class="button nav-book" asp-page="/Reservations/Create">
                            Book a table
                        </a>
                    }
                }
            </nav>
        </header>
        <main id="main-content">
            @RenderBody()
        </main>
        <footer class="site-footer">
            <div class="footer-brand">
                CÉLESTE
                <small>FINE DINING</small>
            </div>
            <nav aria-label="Footer navigation">
                <a asp-page="/Index">
                    Home
                </a>
                <a asp-page="@(staff ? "/Staff/Index" : "/Reservations/Create")">
                    Reservations
                </a>
                <a asp-page="/Menu">
                    Menu
                </a>
                <a asp-page="/Reviews">
                    Reviews
                </a>
                <a asp-page="@(User.Identity?.IsAuthenticated == true ? "/Account/Profile" : "/Account/Login")">
                    Account
                </a>
            </nav>
            <p>
                Thoughtfully crafted. Beautifully shared.
                <small>All reservation times are Malaysia time · UTC+8</small>
            </p>
        </footer>
        
        @if (workspace)
        {
            <script src="https://cdn.jsdelivr.net/npm/tom-select@@2.6.2/dist/js/tom-select.complete.min.js"></script>

            <script>
                    // Apply consistent styling to staff dropdowns.
                    if (window.TomSelect) {
                        document.querySelectorAll(
                            '.staff-search select, ' +
                            '.billing-history-form select, ' +
                            '.order-update select'
                        ).forEach(function (select) {

                            if (!select.tomselect) {
                                new TomSelect(select, {
                                    create: false,
                                    maxItems: 1,
                                    allowEmptyOption: true,
                                    controlInput: null
                                });
                            }

                        });
                    }
            </script>

        }

        <script>
            (function () {
                const header = document.querySelector('.guest-view .site-header');
                const toggle = header?.querySelector('.mobile-menu-toggle');
                const menu = header?.querySelector('#main-navigation');
                if (!header || !toggle || !menu) return;

                function setMenuOpen(open) {
                    header.classList.toggle('menu-open', open);
                    toggle.setAttribute('aria-expanded', String(open));
                    toggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
                }

                toggle.addEventListener('click', () => setMenuOpen(!header.classList.contains('menu-open')));
                menu.addEventListener('click', event => {
                    if (event.target.closest('a')) setMenuOpen(false);
                });
                document.addEventListener('click', event => {
                    if (!header.contains(event.target)) setMenuOpen(false);
                });
                document.addEventListener('keydown', event => {
                    if (event.key === 'Escape' && header.classList.contains('menu-open')) {
                        setMenuOpen(false);
                        toggle.focus();
                    }
                });
                window.addEventListener('resize', () => {
                    if (window.innerWidth > 1100) setMenuOpen(false);
                });
            })();
        </script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>

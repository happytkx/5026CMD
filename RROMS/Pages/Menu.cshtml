@page
@* Digital menu with dietary and protein filters; signed-in customers add dishes to their basket. *@
@model RROMS.Pages.MenuModel
@{
    ViewData["Title"] = "Menu";
}
<section class="account-heading">
    <p class="eyebrow">SEASONAL · THOUGHTFUL · FRESH</p>
    <h1>Our menu</h1>
    <p>A little something for every appetite. Dine-in orders open once you are seated at your table.</p>
</section>
<div class="section-heading menu-toolbar">
    <form method="get" asp-page="/Menu" class="filters menu-filters">
        <input name="q" value="@Model.Q" placeholder="Search dishes" aria-label="Search dishes" />
        <select name="category" aria-label="Category" onchange="this.form.requestSubmit()">
            <option value="">All categories</option>
            @foreach (var c in Model.Categories)
            {
                <option selected="@(Model.Category == c)" value="@c">@c</option>
            }
        </select>
        <select name="dietary" aria-label="Dietary preference" onchange="this.form.requestSubmit()">
            <option value="">No dietary preference</option>
            @foreach (var d in new[] { "Vegetarian", "Vegan", "No pork", "No beef", "No chicken" })
            {
                <option value="@d" selected="@(Model.Dietary == d)">@d</option>
            }
        </select>
        <select name="protein" aria-label="Protein" onchange="this.form.requestSubmit()">
            <option value="">All protein</option>
            @foreach (var p in new[] { "Chicken", "Beef", "Lamb", "Duck", "Seafood", "Molluscs", "Vegetarian" })
            {
                <option value="@p" selected="@(Model.Protein == p)">@p</option>
            }
        </select>
        <div class="menu-highlights-field">
            <label class="visually-hidden" for="menu-highlights">Menu highlights</label>
            <select id="menu-highlights" class="menu-highlights-select" name="Highlights" multiple
                    aria-label="Menu highlights" placeholder="All dishes" data-placeholder="All dishes">
                <option value="popular" selected="@(Model.Highlights.Contains("popular"))">Popular dishes</option>
                <option value="promotion" selected="@(Model.Highlights.Contains("promotion"))">On promotion</option>
            </select>
        </div>
        <button type="submit">Apply</button>
        <a class="button secondary" asp-page="Menu">Clear</a>
    </form>
    @if (User.IsInRole(RROMS.Models.Customer.CustomerRole))
    {
        <a class="button secondary" asp-page="/Orders/Checkout">View basket</a>
    }
    else
    {
        <a class="button secondary" asp-page="/Account/Login" asp-route-ReturnUrl="/Orders/Checkout">Customer sign in</a>
    }
</div>
@if (TempData["Success"] is string ok)
{
    <p class="success">@ok</p>
}
@if (TempData["Error"] is string err)
{
    <p class="error">@err</p>
}
<div class="dish-grid">
    @foreach (var item in Model.Items)
    {
        <article class="dish">
            <div class="dish-art">
                @if (MenuPricing.IsPromotionActive(item, ReservationPolicy.Now) && item.PromotionEndDate.HasValue)
                {
                    var remaining = Math.Max(1, (item.PromotionEndDate.Value.Date - ReservationPolicy.Now.Date).Days + 1);
                    <span class="expiry-badge">@(remaining == 1 ? "1 day left" : $"{remaining} days left")</span>
                }
                <img src="@MenuImages.Url(item)" alt="@MenuImages.Alt(item)" loading="lazy"
                             onerror="this.onerror=null; this.src='/images/celeste-indoor.png'; this.alt='Dining at Céleste';" />
            </div>
            <div class="dish-body">
                <div class="dish-title">
                    <h3>@item.Name</h3>
                </div>
                @if (item.IsPopular || MenuPricing.IsPromotionActive(item, ReservationPolicy.Now))
                {
                    <div class="dish-tags">
                        @if (item.IsPopular)
                        {
                            <span class="badge">Popular</span>
                        }
                        @if (MenuPricing.IsPromotionActive(item, ReservationPolicy.Now))
                        {
                            <span class="badge offer-badge">Save @(item.DiscountPercent?.ToString("0.##"))%</span>
                        }
                    </div>
                }
                <p>@item.Description</p>
                <small>@item.Category · Protein: @item.ProteinType</small>
                <small>Dietary: @(string.IsNullOrWhiteSpace(item.DietaryTags) ? "Not specified" : item.DietaryTags)</small>
                <small>Allergens: @(string.IsNullOrWhiteSpace(item.Allergens) ? "Not specified" : item.Allergens)</small>
                <div class="dish-bottom">
                    <div class="dish-pricing">
                        @if (MenuPricing.IsPromotionActive(item, ReservationPolicy.Now))
                        {
                            <span class="price price-discounted">RM @MenuPricing.CurrentPrice(item, ReservationPolicy.Now).ToString("0.00")</span>
                            <del class="muted">RM @item.Price.ToString("0.00")</del>
                        }
                        else
                        {
                            <span class="price">RM @item.Price.ToString("0.00")</span>
                        }
                    </div>
                    @if (Model.CanOrder)
                    {
                        <form method="post" asp-page-handler="Add">
                            <input type="hidden" name="itemId" value="@item.MenuItemID" />
                            <button type="submit" class="quiet">Add to order</button>
                        </form>
                    }
                    else if (User.IsInRole(RROMS.Models.Customer.CustomerRole))
                    {
                        <span class="muted">Available after check-in</span>
                    }
                    else
                    {
                        <a class="button secondary quiet" asp-page="/Account/Login" asp-route-ReturnUrl="/Menu">Sign in as customer</a>
                    }
                </div>
            </div>
        </article>
    }
</div>
@if (!Model.Items.Any())
{
    <section class="card empty-state">No available dishes match your filters.</section>
}
<p class="fine-print">Food allergy information is provided for guidance. Please tell restaurant staff about severe allergies before ordering.</p>

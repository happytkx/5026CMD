@page
@* Digital menu with dietary, protein and spice filters; signed-in customers add dishes to their basket. *@
@model RROMS.Pages.MenuModel
@{
    ViewData["Title"] = "Menu";
}
<section class="account-heading">
    <p class="eyebrow">SEASONAL · THOUGHTFUL · FRESH</p>
    <h1>Our menu</h1>
    <p>A little something for every appetite. Dine-in orders open once you are seated at your table.</p>
</section>
<div class="section-heading menu-toolbar">
    <form method="get" class="filters menu-filters">
        <input name="q" value="@Model.Q" placeholder="Search dishes" aria-label="Search dishes" />
        <select name="category" aria-label="Category">
            <option value="">All categories</option>
            @foreach (var c in Model.Categories)
            {
                <option selected="@(Model.Category == c)" value="@c">@c</option>
            }
        </select>
        <select name="dietary" aria-label="Dietary preference">
            <option value="">Any dietary preference</option>
            @foreach (var d in new[] { "Vegetarian", "Vegan", "No pork", "No beef", "No chicken" })
            {
                <option value="@d" selected="@(Model.Dietary == d)">@d</option>
            }
        </select>
        <select name="protein" aria-label="Protein">
            <option value="">Any protein</option>
            @foreach (var p in new[] { "Chicken", "Beef", "Lamb", "Duck", "Seafood", "Vegetarian" })
            {
                <option value="@p" selected="@(Model.Protein == p)">@p</option>
            }
        </select>
        <select name="spice" aria-label="Maximum spice level">
            <option value="">Any spice level</option>
            @for (var i = 0; i <= 5; i++)
            {
                <option value="@i" selected="@(Model.Spice == i)">Up to @i / 5</option>
            }
        </select>
        <button type="submit">Apply</button>
        <a class="button secondary" asp-page="Menu">Clear</a>
    </form>
    <a class="button secondary" asp-page="/Orders/Checkout">View basket</a>
</div>
@if (TempData["Success"] is string ok)
{
    <p class="success">@ok</p>
}
@if (TempData["Error"] is string err)
{
    <p class="error">@err</p>
}
<div class="dish-grid">
    @foreach (var item in Model.Items)
    {
        <article class="dish">
            <div class="dish-art">
                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" />
                }
                else
                {
                    <span aria-hidden="true">✳</span>
                }
            </div>
            <div class="dish-body">
                <div class="dish-title">
                    <h3>@item.Name</h3>
                    @if (item.IsPopular)
                    {
                        <span class="badge">Popular</span>
                    }
                </div>
                <p>@item.Description</p>
                <small>@item.Category · Protein: @item.ProteinType · Spice: @item.SpiceLevel/5</small>
                <small>Dietary: @(string.IsNullOrWhiteSpace(item.DietaryTags) ? "Not specified" : item.DietaryTags)</small>
                <small>Allergens: @(string.IsNullOrWhiteSpace(item.Allergens) ? "Not specified" : item.Allergens)</small>
                <div class="dish-bottom">
                    <span class="price">RM @item.Price.ToString("0.00")</span>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form method="post" asp-page-handler="Add">
                            <input type="hidden" name="itemId" value="@item.MenuItemID" />
                            <button type="submit" class="quiet">Add to order</button>
                        </form>
                    }
                    else
                    {
                        <a class="button secondary quiet" asp-page="/Account/Login" asp-route-ReturnUrl="/Menu">Sign in to order</a>
                    }
                </div>
            </div>
        </article>
    }
</div>
@if (!Model.Items.Any())
{
    <section class="card empty-state">No available dishes match your filters.</section>
}
<p class="fine-print">Food allergy information is provided for guidance. Please tell restaurant staff about severe allergies before ordering.</p>

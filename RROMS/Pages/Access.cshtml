@page
@* Displays the local customer/staff role preview when explicitly enabled in Development; otherwise directs users to the group authentication module. *@
@model RROMS.Pages.AccessModel
@{
    ViewData["Title"] = "Access";
}
<h1>Reservation access</h1>
<p>Your group’s Sprint 1 login should issue a Customer or Restaurant Staff role and the customer ID claim.</p>
<div asp-validation-summary="All" class="error">
</div>
@if (Model.DemoEnabled)
{
    <section class="card">
        <h2>Development preview</h2>
        <p>This local preview lets you test Sprint 2 before the group login is connected. It is disabled outside Development and requires an explicit configuration setting.</p>
        <form method="post">
            <label asp-for="CustomerId">Customer account</label>
            <select asp-for="CustomerId">
                @foreach (var c in Model.Customers)
                {
                    <option value="@c.CustomerID">
                        @c.CustomerName
                    </option>
                }
            </select>
            <button name="role" value="Customer">Preview as customer</button>
            <button name="role" value="Restaurant Staff" class="secondary">Preview as staff</button>
        </form>
    </section>
}
else
{
    <p>Please sign in through the group authentication module.</p>
}

@page
@* Reservations appear as one dining session, with each placed round available in View Details. *@
@model RROMS.Pages.Orders.IndexModel
@{
    ViewData["Title"] = "My orders";
    var sessions = Model.Items.GroupBy(o => o.ReservationID)
        .OrderByDescending(g => g.Max(o => o.CreatedAt)).ToList();
}
<section class="account-heading">
    <p class="eyebrow">YOUR CÉLESTE ORDERS</p>
    <h1>My orders</h1>
    <p>Follow the dishes ordered during each reservation. Status updates refresh while this page is open.</p>
</section>
<div class="order-history-actions">
    <a class="button secondary" asp-page="/MyBill">View Bill</a>
    <a class="button" asp-page="/Menu">Order</a>
</div>
@if (TempData["Success"] is string ok)
{
    <p class="success">@ok</p>
}
@if (TempData["Error"] is string err)
{
    <p class="error">@err</p>
}
@foreach (var session in sessions)
{
    var rounds = session.OrderBy(o => o.CreatedAt).ThenBy(o => o.OrderID).ToList();
    var booking = rounds[0].Reservation;
    <article class="card order-card dining-session-card">
        <div class="order-head">
            <div>
                <p class="reference">RESERVATION · @booking.BookingReference</p>
                <h2>@booking.ReservationDate.ToString("dd MMM yyyy") · Table @booking.TableID</h2>
                <p class="order-card-meta">
                    @DiningOrderPresentation.ActiveItemCount(rounds) items ·
                    @rounds.Count ordering round@(rounds.Count == 1 ? "" : "s")
                </p>
            </div>
            <div class="order-side">
                <span class="badge">@DiningOrderPresentation.Status(rounds)</span>
                <p class="price">RM @DiningOrderPresentation.Total(rounds).ToString("N2")</p>
                <small>Food and tax, before deposit</small>
            </div>
        </div>
        <details class="order-details">
            <summary>
                <strong>View Details</strong>
                <span>Dishes, quantities and status</span>
            </summary>
            <div class="order-details-body">
                @foreach (var o in rounds)
                {
                    <div class="order-round">
                        <div class="order-round-heading">
                            <strong>Ordered @o.CreatedAt.ToString("dd MMM, h:mm tt")</strong>
                            <span class="badge">@o.Status</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(o.Notes))
                        {
                            <p class="order-notes">Special request: @o.Notes</p>
                        }
                        <div class="table-wrap">
                            <table class="order-detail-table">
                                <thead>
                                    <tr>
                                        <th>Dish</th>
                                        <th>Qty</th>
                                        <th>Unit Price</th>
                                        <th>Total Price</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var line in o.Lines.OrderBy(l => l.OrderLineID))
                                {
                                    var cancelled = line.IsCancelled || o.Status == "Cancelled";
                                    <tr class="@(cancelled ? "cancelled-line" : "")">
                                        <td>@line.ItemName</td>
                                        <td>@line.Quantity</td>
                                        <td>RM @line.UnitPrice.ToString("N2")</td>
                                        <td>@(cancelled ? "Excluded" : $"RM {line.LineTotal:N2}")</td>
                                        <td><span class="@(cancelled ? "dish-cancelled" : "dish-active")">@(cancelled ? "Cancelled" : o.Status)</span></td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        @if (o.Status == "Completed" && !Model.ReviewedOrderIds.Contains(o.OrderID))
                        {
                            <form method="post" asp-page-handler="Review" class="review-form">
                                <input type="hidden" name="orderId" value="@o.OrderID" />
                                <div>
                                    <label for="rating-@o.OrderID">Rating</label>
                                    <select id="rating-@o.OrderID" name="rating">
                                        <option value="5">5 - Excellent</option>
                                        <option value="4">4 - Good</option>
                                        <option value="3">3 - Okay</option>
                                        <option value="2">2 - Poor</option>
                                        <option value="1">1 - Bad</option>
                                    </select>
                                </div>
                                <div>
                                    <label for="comment-@o.OrderID">Feedback</label>
                                    <textarea id="comment-@o.OrderID" name="comment" rows="2" maxlength="800" placeholder="Tell us about your experience" required></textarea>
                                </div>
                                <button type="submit" class="secondary">Submit review</button>
                            </form>
                        }
                        else if (Model.ReviewedOrderIds.Contains(o.OrderID))
                        {
                            <small class="order-review-note">Review submitted. Thank you for dining with us.</small>
                        }
                    </div>
                }
            </div>
        </details>
    </article>
}
@if (!sessions.Any())
{
    <section class="card empty-state">You haven't placed an order yet.</section>
}
@section Scripts {
    <script>
        // Refresh statuses without interrupting someone viewing details or writing feedback.
        setTimeout(function () {
            if (!document.hidden && !document.querySelector('.order-details[open], .review-form :focus'))
                window.location.reload();
        }, 30000);
    </script>
}

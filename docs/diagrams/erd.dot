digraph G {
graph [rankdir=LR, bgcolor="white", pad=0.4, nodesep=0.5, ranksep=1.5, splines=polyline, fontname="Arial", fontsize=22, labelloc=t, label="Céleste RROMS — Database ERD\nSelected attributes; full definitions in accompanying Mermaid source"];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=10, color="#526779"];
Administrators [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#F6D4B6"><B>Administrators</B></TD></TR><TR><TD ALIGN="LEFT">int AdministratorID PK<BR ALIGN="LEFT"/>int CustomerID FK,UK<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

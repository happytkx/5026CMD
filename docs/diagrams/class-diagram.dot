digraph G {
graph [rankdir=LR, bgcolor="white", pad=0.4, nodesep=0.5, ranksep=1.5, splines=polyline, fontname="Arial", fontsize=22, labelloc=t, label="Céleste RROMS — Implementation Class Diagram\nSelected attributes; full definitions in accompanying Mermaid source"];
